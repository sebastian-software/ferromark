{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "component": "ferromark",
      "changelog-path": "CHANGELOG.md",
      "versioning": "prerelease",
      "prerelease-type": "rc",
      "prerelease": true,
      "extra-files": [
        {
          "type": "json",
          "path": "node/ferromark/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "node/ferromark/npm/*/package.json",
          "glob": true,
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "README.md.src"
        },
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": "node/ferromark/README.md"
        }
      ]
    }
  }
}
