#!/bin/sh
set -eu
export PYTHONDONTWRITEBYTECODE=1
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "${FERROMARK_BENCH_PYTHON:-}" ]; then
  "$FERROMARK_BENCH_PYTHON" -c 'import sys; sys.exit(sys.version_info < (3, 11))' || {
    echo 'FERROMARK_BENCH_PYTHON must select Python 3.11+.' >&2
    exit 1
  }
  exec "$FERROMARK_BENCH_PYTHON" "$repo/benchmarks/manual-macos/cli.py" "$@"
fi
for candidate in python3 python3.14 python3.13 python3.12 python3.11; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))'; then
    exec "$candidate" "$repo/benchmarks/manual-macos/cli.py" "$@"
  fi
done
echo 'Python 3.11+ is required. Install it or set FERROMARK_BENCH_PYTHON to its executable.' >&2
exit 1
