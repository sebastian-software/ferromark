{
  "name": "ferromark-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Executable repository contracts run by the CI fmt job",
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --test ./test-*.mjs",
    "gemoji:data": "node ./generate-gemoji-data.mjs --write",
    "gemoji:data:check": "node ./generate-gemoji-data.mjs",
    "reference:remark-github:fixtures": "node ./regenerate-remark-github-fixtures.mjs --write",
    "reference:transforms:fixtures": "node ./regenerate-transform-oracle-fixtures.mjs --write"
  },
  "devDependencies": {
    "@iarna/toml": "3.0.0",
    "@mavrin/remark-typograf": "2.1.6",
    "gemoji": "8.1.0",
    "oxfmt": "0.57.0",
    "release-please": "17.6.0",
    "remark": "15.0.1",
    "remark-emoji": "5.0.2",
    "remark-gemoji": "8.0.0",
    "remark-gfm": "4.0.0",
    "remark-github": "12.0.0",
    "remark-smartypants": "3.0.3",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.17.0"
}
