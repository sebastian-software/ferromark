From ac793b2560dc024f55f2c42dfb17736faf494ac6 Mon Sep 17 00:00:00 2001
From: Sebastian Werner <swernerx@users.noreply.github.com>
Date: Mon, 21 Sep 2026 20:38:44 +0200
Subject: [PATCH] perf(parser): count inline nesting in a plain cell on the
 parser
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

`Parser::nested_inline_depth` held `Cell<Option<&'a Cell<usize>>>`: a
counter allocated in the arena on the first inline context and then shared
by pointer with every sub-parser, so that an inline note's body could
report its depth into the enclosing inline level. Every parse paid for
that sharing — an arena allocation plus an indirection on each read and
write, in `InlineDepthGuard` on entry to and exit from every
`parse_inline` and in `process_emphasis` — although only `^[...]` needs
it.

The counter is now a plain `Cell<usize>` that each parser owns, and the
one sub-parser built from inside an inline context hands its result back
by hand: `parse_inline_footnote` takes it through
`Parser::inline_note_sub_parser` and folds the depth the body finished
with into this level with `fold_nested_inline_depth`, before the `?` so
the failing exit counts like the succeeding one — which is what the shared
cell did when the sub-parse's guard dropped. The sub-parser still starts
from the enclosing level's count, exactly as the shared cell handed it
over, so the fold's maximum reproduces that cell's value.

Every nesting decision is unchanged. Only a sub-parser built while an
inline context is open can nest inside a node the parent is still
building; a `debug_assert!` on `inline_depth` in
`sub_parser_with_lazy_lines` holds the block sub-sources — block quotes,
list items, footnote bodies, definition-list bodies, JSX children — to
that, and the whole suite exercises it. Their counter was shared before
but never read before the next `parse_inline` reset it, so keeping it
private changes nothing. `tests/nesting_depth.rs`, `tests/input_panics.rs`,
`tests/emphasis_pairing.rs` and `tests/nested_links.rs` pass unchanged, as
do the snapshots and the CommonMark and GFM baselines. A differential run
over 16,480 parses — notes inside, around and beside emphasis and brackets
across the cap boundary, plus the bundled corpora, in five option profiles
including an uncapped and a depth-7 one — matched the parent commit on the
HTML, the AST and the exact `NestingTooDeep` spans.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/parser/inline.rs          | 33 ++++++++---------
 src/parser/inline/emphasis.rs |  2 +-
 src/parser/inline_footnote.rs | 12 +++++--
 src/parser/mod.rs             | 68 +++++++++++++++++++++++++++--------
 4 files changed, 78 insertions(+), 37 deletions(-)

diff --git a/src/parser/inline.rs b/src/parser/inline.rs
index e0468476..f1622a48 100644
--- a/src/parser/inline.rs
+++ b/src/parser/inline.rs
@@ -116,7 +116,7 @@ impl<'a> Parser<'a> {
             .into());
         }
         self.inline_depth.set(depth + 1);
-        let nested = self.nested_depth_cell();
+        let nested = &self.nested_inline_depth;
         Ok(InlineDepthGuard {
             depth: &self.inline_depth,
             nested,
@@ -124,36 +124,31 @@ impl<'a> Parser<'a> {
         })
     }
 
-    /// The nested-inline-depth counter as it stands, without allocating it.
+    /// The nested-inline-depth counter as it stands.
     ///
     /// An inline context that is opened and then thrown away whole — the
     /// in-place bracket walk that finds a construct reaching past its
     /// closing bracket — has to leave the counter as it found it, or the
     /// probe that settles the same text afterwards would be counted twice.
     pub(super) fn nested_inline_depth(&self) -> usize {
-        self.nested_inline_depth
-            .get()
-            .map_or(0, std::cell::Cell::get)
+        self.nested_inline_depth.get()
     }
 
     /// Puts back a value from [`Self::nested_inline_depth`].
     pub(super) fn restore_nested_inline_depth(&self, depth: usize) {
-        if let Some(cell) = self.nested_inline_depth.get() {
-            cell.set(depth);
-        }
+        self.nested_inline_depth.set(depth);
     }
 
-    /// The shared depth cell, allocated on the first inline context of a
-    /// parse. A parser that never reaches inline content — the definition
-    /// pre-pass, and every rejected block probe — leaves the arena
-    /// untouched, which its own tests hold it to.
-    fn nested_depth_cell(&self) -> &'a std::cell::Cell<usize> {
-        if let Some(cell) = self.nested_inline_depth.get() {
-            return cell;
-        }
-        let cell: &'a std::cell::Cell<usize> = &*self.allocator.alloc(std::cell::Cell::new(0));
-        self.nested_inline_depth.set(Some(cell));
-        cell
+    /// Folds the depth a sub-parser finished with into this level's count.
+    ///
+    /// An inline note's body is parsed by a sub-parser and still becomes
+    /// children of the node this level is about to wrap, so the deeper of
+    /// the two is what the level has below it. Taking the maximum is what
+    /// the counter cell the two parsers used to share did on the way out of
+    /// the sub-parse, and it keeps the count monotonic on either exit.
+    pub(super) fn fold_nested_inline_depth(&self, depth: usize) {
+        self.nested_inline_depth
+            .set(self.nested_inline_depth.get().max(depth));
     }
 
     pub(super) fn parse_inline(
diff --git a/src/parser/inline/emphasis.rs b/src/parser/inline/emphasis.rs
index 49ea1d14..903f509b 100644
--- a/src/parser/inline/emphasis.rs
+++ b/src/parser/inline/emphasis.rs
@@ -206,7 +206,7 @@ impl<'a> Parser<'a> {
         // same budget as the nodes pairing is about to build, and so does
         // everything the sequence itself is nested in. Both are read once:
         // the scan is finished, so neither can change from here on.
-        let nested = self.nested_depth_cell();
+        let nested = &self.nested_inline_depth;
         let inside = nested.get() as u32;
         let enclosing = self.inline_depth.get().saturating_sub(1);
         let mut produced = inside;
