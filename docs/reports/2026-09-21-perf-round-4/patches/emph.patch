diff --git a/src/parser/inline/emphasis.rs b/src/parser/inline/emphasis.rs
index 49ea1d14..b7edf902 100644
--- a/src/parser/inline/emphasis.rs
+++ b/src/parser/inline/emphasis.rs
@@ -45,6 +45,24 @@ pub(in crate::parser) struct Delimiter {
 /// The end of the delimiter list in either direction.
 const NO_DELIMITER: usize = usize::MAX;
 
+/// The buffer one inline context records its delimiter runs in, parked here
+/// between contexts.
+///
+/// Every context used to build its own vector, so each paragraph, heading or
+/// cell holding a single `*` paid an arena allocation and — once past four
+/// runs — bumpalo's grow-and-copy ladder as well. The runs of one context are
+/// dead the moment its pairing is done, and nothing outside pairing ever reads
+/// them, so one buffer serves the whole parse: it is taken when a context
+/// records its first run and handed back, cleared on the next take, when the
+/// context ends.
+///
+/// The slot only ever holds a buffer no context is using. A nested context
+/// (link text, an image alt, an inline note) that starts while the enclosing
+/// one holds the buffer finds the slot empty and gets its own, which keeps the
+/// enclosing runs untouched; whichever of the two can hold more runs stays in
+/// the slot afterwards.
+pub(in crate::parser) type DelimiterScratch<'a> = std::cell::Cell<Option<Vec<'a, Delimiter>>>;
+
 /// Takes `index` out of the list of runs still worth visiting.
 ///
 /// The depth of the node the run holds is folded into the run before it,
@@ -67,14 +85,55 @@ fn unlink(delimiters: &mut [Delimiter], index: usize) {
 }
 
 impl<'a> Parser<'a> {
+    /// The shared scratch slot, allocated in the arena the first time a run
+    /// is recorded or a sub-parser is built. A parse that pairs no emphasis
+    /// and opens no container — and every block probe that never reaches
+    /// inline content — leaves the arena as it is.
+    pub(in crate::parser) fn delimiter_scratch(&self) -> &'a DelimiterScratch<'a> {
+        if let Some(slot) = self.delimiter_scratch.get() {
+            return slot;
+        }
+        let slot: &'a DelimiterScratch<'a> = &*self.allocator.alloc(std::cell::Cell::new(None));
+        self.delimiter_scratch.set(Some(slot));
+        slot
+    }
+
+    /// The buffer this context records its runs in: the parked one, emptied,
+    /// or a fresh one while an enclosing context holds that.
+    fn take_delimiters(&self) -> Vec<'a, Delimiter> {
+        match self.delimiter_scratch().take() {
+            Some(mut buffer) => {
+                buffer.clear();
+                buffer
+            }
+            None => self.allocator.new_vec(),
+        }
+    }
+
+    /// Parks a finished context's buffer for the next one.
+    ///
+    /// A nested context hands its own buffer back before the context around
+    /// it does, so both reach here; keeping the wider one stops a long run
+    /// inside link text from being re-grown for every link.
+    pub(in crate::parser) fn put_delimiters(&self, buffer: Vec<'a, Delimiter>) {
+        let slot = self.delimiter_scratch();
+        match slot.take() {
+            Some(parked) if parked.capacity() >= buffer.capacity() => slot.set(Some(parked)),
+            _ => slot.set(Some(buffer)),
+        }
+    }
+
     /// Records a `*`/`_`/`~`/`==` run: pushes its text node and the delimiter
     /// entry describing how it may participate in emphasis.
+    ///
+    /// The run buffer is borrowed from the parser here rather than by the
+    /// caller, so a context that records no run never asks for one.
     pub(in crate::parser) fn push_delimiter_run(
         &self,
         content: &'a str,
         offset: usize,
         children: &mut Vec<'a, Node<'a>>,
-        delimiters: &mut Vec<'a, Delimiter>,
+        delimiters: &mut Option<Vec<'a, Delimiter>>,
         pos: &mut usize,
     ) {
         let bytes = content.as_bytes();
@@ -98,6 +157,7 @@ impl<'a> Parser<'a> {
         if !can_open && !can_close {
             return;
         }
+        let delimiters = delimiters.get_or_insert_with(|| self.take_delimiters());
         let index = delimiters.len();
         let prev = match delimiters.last_mut() {
             Some(last) => {
diff --git a/src/parser/mod.rs b/src/parser/mod.rs
