--- a/src/parser/mod.rs
+++ b/src/parser/mod.rs
@@ -260,6 +260,20 @@ pub struct Parser<'a> {
     /// that only probes blocks still touches the arena not at all.
     nested_inline_depth: std::cell::Cell<Option<&'a std::cell::Cell<usize>>>,
 
+    /// The delimiter-run buffer inline contexts record their `*`, `_`, `~`
+    /// and `==` runs in, one per parse instead of one per context.
+    ///
+    /// Shared with sub-parsers and held behind a reference for the same two
+    /// reasons as `nested_inline_depth`: inline parsing runs behind `&self`,
+    /// and a list item or block quote builds its own parser for content that
+    /// is no different from the content around it. The slot is allocated in
+    /// the arena on the first run a parse records, or on the first sub-parser
+    /// it builds, so a parse that neither pairs emphasis nor opens a
+    /// container — and every block probe that never reaches inline content —
+    /// still touches the arena not at all. See the `inline::DelimiterScratch`
+    /// alias for how one buffer serves contexts nested in one another.
+    delimiter_scratch: std::cell::Cell<Option<&'a inline::DelimiterScratch<'a>>>,
+
     /// Link reference definitions collected by the root parser's
     /// pre-pass, shared with sub-parsers (block quote and list item
     /// contents) so references resolve document-wide.
@@ -448,6 +462,7 @@ impl<'a> Parser<'a> {
             nesting_depth: 0,
             inline_depth: std::cell::Cell::new(0),
             nested_inline_depth: std::cell::Cell::new(None),
+            delimiter_scratch: std::cell::Cell::new(None),
             definitions: None,
             phase,
             footnote_labels: None,
@@ -515,6 +530,14 @@ impl<'a> Parser<'a> {
             // sub-parser and still ends up inside the node the enclosing
             // inline level is building, so its depth has to reach that level.
             nested_inline_depth: std::cell::Cell::new(self.nested_inline_depth.get()),
+            // Shared as well: the runs of a sub-source are the same kind of
+            // scratch as the ones around it, and a parked buffer is one no
+            // context is using. The slot is allocated here when this parser
+            // has none yet, because a list of items or a run of quotes parses
+            // all of its inline content through sub-parsers and would
+            // otherwise start each one with an empty slot — one buffer per
+            // item, which is what this replaces.
+            delimiter_scratch: std::cell::Cell::new(Some(self.delimiter_scratch())),
             definitions: self.definitions.clone(),
             phase: self.phase,
             footnote_labels: self.footnote_labels.clone(),
diff --git a/tests/emphasis_pairing.rs b/tests/emphasis_pairing.rs
index 12d1a69f..5e9dd42a 100644
--- a/tests/emphasis_pairing.rs
+++ b/tests/emphasis_pairing.rs
@@ -221,6 +221,56 @@ fn a_long_sequence_of_unpairable_delimiters_stays_literal() {
     check_tree(&source);
 }
 
+#[test]
+fn a_nested_context_never_disturbs_the_runs_around_it() {
+    // The delimiter runs of one inline context are recorded in a buffer the
+    // parser hands from context to context. Link text, image alt text and a
+    // sub-source each open a context of their own, some of them while the
+    // context around them still holds unpaired runs, so each has to record
+    // and pair its own without touching the enclosing ones.
+    let cases = [
+        (
+            "*a [*b* **c**](u) d*",
+            "<p><em>a <a href=\"u\"><em>b</em> <strong>c</strong></a> d</em></p>",
+        ),
+        (
+            "*a ![*b* c](/img) d*",
+            "<p><em>a <img src=\"/img\" alt=\"b c\"> d</em></p>",
+        ),
+        (
+            "*x [~~y~~ z](u) w*",
+            "<p><em>x <a href=\"u\"><del>y</del> z</a> w</em></p>",
+        ),
+        (
+            "> *a b*\n\n- *c* and **d**\n- ~~e~~\n",
+            concat!(
+                "<blockquote>\n<p><em>a b</em></p>\n</blockquote>\n",
+                "<ul>\n<li><em>c</em> and <strong>d</strong></li>\n<li><del>e</del></li>\n</ul>"
+            ),
+        ),
+        (
+            "| *a* | **b** |\n| --- | --- |\n| ~~c~~ | *d* |\n",
+            concat!(
+                "<table>\n<thead>\n<tr>\n<th><em>a</em></th>\n<th><strong>b</strong></th>\n</tr>\n",
+                "</thead>\n<tbody>\n<tr>\n<td><del>c</del></td>\n<td><em>d</em></td>\n</tr>\n",
+                "</tbody>\n</table>"
+            ),
+        ),
+    ];
+    for (source, expected) in cases {
+        assert_eq!(render(source), expected, "for {source:?}");
+        check_tree(source);
+    }
+
+    // The same shape repeated: every context after the first pairs in a
+    // buffer an earlier one already used.
+    let source = "*a [*b* **c**](u) d*\n\n".repeat(200);
+    let rendered = render(&source);
+    assert_eq!(rendered.matches("<em>").count(), 400);
+    assert_eq!(rendered.matches("<strong>").count(), 200);
+    check_tree(&source);
+}
+
 #[test]
 fn emphasis_pairing_costs_linear_time() {
     // Compare equal bytes of work: four smaller parses against one 4x input.
