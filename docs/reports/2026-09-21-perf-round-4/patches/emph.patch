-        let mut delimiters = self.allocator.new_vec();
         let mut pos = 0;
         let mut first_scan = Some(first_special);
 
@@ -233,14 +266,17 @@ impl<'a> Parser<'a> {
                 content,
                 offset,
                 &mut children,
-                &mut delimiters,
