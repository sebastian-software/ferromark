-        #[cfg(target_arch = "aarch64")]
+        #[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
         {
             let first_event =
                 (0..body.len()).find(|&at| body[at] == 0 || body[at..].starts_with(b"]:"));
@@ -243,13 +438,29 @@ mod tests {
                 first_event,
