+#[inline(never)]
+fn first_attr_escape_long(input: &[u8]) -> Option<usize> {
+    let mut start = 0;
+    let mut width = SHORT_SCAN_MAX * 1;
+    while start < input.len() {
+        let len = width.min(input.len() - start);
+        let chunk = &input[start..start + len];
+        let a = memchr3(b'<', b'>', b'&', chunk);
+        let limit = a.unwrap_or(chunk.len());
+        if let Some(at) = memchr2(b'"', b'\'', &chunk[..limit]).or(a) { return Some(start + at); }
+        start += len;
+        width = width.saturating_mul(2);
+    }
+    None
+}
