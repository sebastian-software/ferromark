+            counts.push(COMMON_SEARCH_BYTES.with(std::cell::Cell::get));
+            assert_eq!(
+                actual,
+                format!("<pre><code>{}</code></pre>\n", body.replace('"', "&quot;"))
+            );
+        }
+        assert!(counts[1] <= 2 * counts[0] + 16_384, "search work: {counts:?}");
+    }
