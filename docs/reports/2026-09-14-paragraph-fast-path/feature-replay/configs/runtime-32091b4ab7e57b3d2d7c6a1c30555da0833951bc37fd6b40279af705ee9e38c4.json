{
  "parser": {
    "autolinks": true,
    "definition_lists": true,
    "footnotes": true,
    "front_matter": true,
    "gfm": true,
    "heading_attributes": true,
    "line_comments": true,
    "strikethrough": true,
    "tables": true,
    "task_lists": true
  },
  "renderer": {
    "callouts": true,
    "code_fence_metadata": true,
    "disallow_raw_html": true,
    "heading_ids": true,
    "inline_toc": true,
    "semantic_footnotes": true
  }
}
