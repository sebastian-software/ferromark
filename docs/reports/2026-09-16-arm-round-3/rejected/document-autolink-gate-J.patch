+//! Differential tests for the document-level autolink gate.
+//!
+//! The gate only ever *skips* the per-block pre-flight, so every document
+//! must parse to exactly the same AST — spans included — whether the root
+//! parser scanned for needles or was forced back to
+//! [`AutolinkNeedles::EVERY`], the "every needle may occur" state that keeps
+//! the ungated path reachable.
+
+// Owned strings keep the test oracle independent of arena storage.
+#![allow(
+    clippy::disallowed_macros,
+    clippy::disallowed_methods,
+    clippy::disallowed_types
+)]
+
+use crate::allocator::Allocator;
+use crate::parser::{Parser, ParserOptions};
+
+use super::AutolinkNeedles;
+
+const COMMONMARK_SPEC: &str =
+    include_str!("../../../../tests/spec_fixtures/commonmark-0.31.2-spec.txt");
+const GFM_SPEC: &str = include_str!("../../../../tests/spec_fixtures/gfm-extensions-spec.txt");
+
+/// The option sets every case is parsed under: the GFM preset that turns
+/// autolinks on, the strict spec profile, CommonMark with autolinks off, and
+/// a profile with every syntax extension that can build its own sub-source.
+fn profiles() -> Vec<(&'static str, ParserOptions)> {
+    vec![
+        ("gfm", ParserOptions::gfm()),
+        ("gfm_spec", ParserOptions::gfm_spec()),
+        ("commonmark", ParserOptions::default()),
+        (
+            "everything",
+            ParserOptions {
+                mdx: true,
+                math: true,
+                definition_lists: true,
+                highlight: true,
+                superscript: true,
+                subscript: true,
+                inline_footnotes: true,
+                line_comments: true,
+                front_matter: true,
+                table_attributes: true,
+                merged_table_cells: true,
+                wiki_links: true,
+                heading_attributes: true,
+                ..ParserOptions::gfm()
+            },
+        ),
+    ]
+}
+
+/// Parses `source` twice — once with the gate the root parser computed, once
+/// with the gate forced open — and returns both debug trees.
+fn debug_trees(source: &str, options: ParserOptions) -> (String, String) {
+    let allocator = Allocator::new();
+    let gated = Parser::with_options(&allocator, source, options.clone()).parse();
+    let mut ungated_parser = Parser::with_options(&allocator, source, options);
+    // The ungated path: claim every needle, exactly as a parser that never
+    // ran the document scan does.
+    ungated_parser.autolink_needles = AutolinkNeedles::EVERY;
+    let ungated = ungated_parser.parse();
+    (format!("{gated:#?}"), format!("{ungated:#?}"))
+}
+
+#[track_caller]
+fn assert_gate_is_transparent(source: &str, profile: &str, options: ParserOptions) {
+    let (gated, ungated) = debug_trees(source, options);
+    if gated == ungated {
+        return;
+    }
+    let at = gated
+        .char_indices()
+        .zip(ungated.char_indices())
+        .find_map(|((index, left), (_, right))| (left != right).then_some(index))
+        .unwrap_or_else(|| gated.len().min(ungated.len()));
+    let window = at.saturating_sub(120);
+    panic!(
+        "profile {profile}: the autolink gate changed the AST\n\
+         source: {source:?}\n\
+         gated:   ...{}\n\
+         ungated: ...{}",
+        &gated[window..(at + 120).min(gated.len())],
+        &ungated[window..(at + 120).min(ungated.len())],
+    );
+}
+
+#[track_caller]
+fn check_every_profile(source: &str) {
+    for (profile, options) in profiles() {
+        assert_gate_is_transparent(source, profile, options);
+    }
+}
+
+/// Markdown inputs of every conformance example in a `spec.txt` fixture.
+///
+/// Tabs are stored as `→` in the fixtures, as the spec suites' own loader
+/// documents; they are restored here so the parser sees real tabs.
+fn spec_examples(text: &str) -> Vec<String> {
+    const FENCE: &str = "````````````````````````````````";
+
+    let mut examples = Vec::new();
+    let mut lines = text.lines();
+    while let Some(line) = lines.next() {
+        let is_example = line
+            .strip_prefix(FENCE)
+            .is_some_and(|rest| rest.trim() == "example" || rest.trim().starts_with("example "));
+        if !is_example {
+            continue;
+        }
+        let mut markdown = String::new();
+        for body_line in lines.by_ref() {
+            if body_line.starts_with(FENCE) || body_line == "." {
+                break;
+            }
+            markdown.push_str(body_line);
+            markdown.push('\n');
+        }
+        examples.push(markdown.replace('→', "\t"));
+    }
+    examples
+}
+
+#[test]
+fn gate_is_transparent_on_commonmark_spec_examples() {
+    let examples = spec_examples(COMMONMARK_SPEC);
+    assert!(examples.len() > 600, "spec loader found {}", examples.len());
+    for example in &examples {
+        check_every_profile(example);
+    }
+}
+
+#[test]
+fn gate_is_transparent_on_gfm_spec_examples() {
+    let examples = spec_examples(GFM_SPEC);
+    assert!(examples.len() > 20, "spec loader found {}", examples.len());
+    for example in &examples {
+        check_every_profile(example);
+    }
+}
+
+#[test]
+fn gate_is_transparent_on_whole_spec_documents() {
+    // Corpus-sized prose: both fixtures are ordinary Markdown documents that
+    // mix every block type with URLs, emails, and bare `://` in code.
+    for source in [COMMONMARK_SPEC, GFM_SPEC] {
+        assert_gate_is_transparent(source, "gfm", ParserOptions::gfm());
+        assert_gate_is_transparent(source, "commonmark", ParserOptions::default());
+    }
+}
+
+/// The needle-bearing fragments a generated document is built from, paired
+/// with the container shapes that give the block parser a sub-source.
+const NEEDLE_BODIES: [&str; 22] = [
+    "plain prose with no needle at all",
+    "http://example.com",
+    "https://example.com/path?q=1&r=2",
+    "ftp://files.example.com/pub",
+    "see www.example.com now",
+    "WWW.example.com stays literal",
+    "user@example.com",
+    "mailto:user@example.com",
+    "xmpp:user@example.com/resource",
+    "mailto: with no address",
+    "xmpp: with no address",
+    "an @ on its own",
+    "a colon: and a slash / apart",
+    "`http://code.example.com`",
+    "[text](http://example.com)",
+    "[text](https://example.com) and http://bare.example",
+    "<https://example.com>",
+    "<a href=\"http://example.com\">raw</a>",
+    "an &#64;entity.example that decodes",
+    "user&#64;example.com beside http://x.test",
+    "ends with www",
+    "trailing colon:",
+];
+
+/// Container shapes, each `{}` filled with one body above.
+const CONTAINERS: [&str; 14] = [
+    "{}",
+    "# {}",
+    "## {} ##",
+    "> {}",
+    "> > {}",
+    "- {}",
+    "- item\n\n  {}",
+    "1. {}",
+    "| a | b |\n| - | - |\n| {} | x |",
+    "[^note]: {}\n\nbody[^note]",
+    "Term\n: {}",
+    "*{}*",
+    "~~{}~~",
+    "<div>\n\n{}\n\n</div>",
+];
+
+#[test]
+fn gate_is_transparent_on_every_container_and_needle() {
+    for body in NEEDLE_BODIES {
+        for container in CONTAINERS {
+            check_every_profile(&container.replace("{}", body));
+        }
+    }
+}
+
+#[test]
+fn gate_is_transparent_on_documents_holding_one_needle_kind() {
+    for source in [
+        // Emails only: no `www.` and no `://` anywhere.
+        "Write to user@example.com or admin@example.org.\n\n- team@example.net\n",
+        // `www.` only: no `@` and no `://` anywhere.
+        "Visit www.example.com.\n\n> www.example.org\n\n- www.example.net\n",
+        // Bare schemes only.
+        "Go to http://example.com.\n\n> https://example.org\n",
+        // Extended schemes with an address, so `@` is present.
+        "mailto:user@example.com and xmpp:user@example.org\n",
+        // Extended scheme words with no address at all: the pre-flight needs
+        // the `@` before either can matter.
+        "mailto: and xmpp: are schemes\n\n> mailto:\n",
+        // Needles only inside constructs the pass never descends into.
+        "```\nhttp://example.com\nwww.example.com\nuser@example.com\n```\n",
+        "    http://example.com\n    user@example.com\n",
+        "`http://example.com` and `user@example.com`\n",
+        "<pre>\nhttp://example.com\n</pre>\n",
+        // A markdown destination is the one `://` the block pre-flight
+        // excludes; the document gate keeps it, which is still a superset.
+        "[one](http://example.com) [two](https://example.org)\n",
+        "[one]: http://example.com\n\n[one]\n",
+        // Nothing at all.
+        "Just prose. With sentences, commas; and semicolons.\n\n## Heading\n\n- item\n",
+        "",
+        "\n\n\n",
+    ] {
+        check_every_profile(source);
+    }
+}
+
+#[test]
+fn gate_is_transparent_when_the_root_source_is_rewritten() {
+    for source in [
+        // Front matter is cut off the root source before the scan: needles in
+        // it can never reach a block.
+        "---\nsite: www.example.com\ncontact: me@example.com\n---\n\nPlain prose here.\n",
+        "---\nsite: plain\n---\n\nVisit www.example.com.\n",
+        // Line comments survive the scan and are stripped per paragraph.
+        "// www.example.com\nPlain prose here.\n",
+        "// comment\nVisit www.example.com.\n",
+        "text\n// user@example.com\nmore text\n",
+        // A BOM shifts the normalized source start.
+        "\u{feff}Visit www.example.com.\n",
+        "\u{feff}Plain prose here.\n",
+        // NUL becomes U+FFFD, which lengthens the normalized source.
+        "a\0b www.example.com\n",
+        "a\0b plain prose\n",
+        // Lazy continuation and tab expansion build joined sub-sources.
+        "> paragraph\nwww.example.com\n",
+        "> paragraph\nplain text\n",
+        "-\twww.example.com\n",
+        // A table pipe escape is unescaped into the cell source.
+        "| a | b |\n| - | - |\n| www\\|.example.com | x |\n",
+        "| a | b |\n| - | - |\n| x\\|y | http://example.com |\n",
+    ] {
+        check_every_profile(source);
+    }
+}
+
+#[test]
+fn gate_is_transparent_on_generated_needle_mixes() {
+    let tokens = [
+        "www.",
+        "://",
+        "http",
+        "@",
+        "mailto:",
+        "xmpp:",
+        "a.b",
+        " ",
+        "\n",
+        "\n\n",
+        "> ",
+        "- ",
+        "# ",
+        "`",
+        "[x](",
+        ")",
+        "\t",
+        "é",
+        "example.com",
+    ];
+    let mut state = 0x51ed_2701_ab34_9f6du64;
+    let mut next = move || {
+        state = state
+            .wrapping_mul(6_364_136_223_846_793_005)
+            .wrapping_add(1);
+        (state >> 33) as usize
+    };
+    for _ in 0..1500 {
+        let len = next() % 20;
+        let mut source = String::new();
+        for _ in 0..len {
+            source.push_str(tokens[next() % tokens.len()]);
+        }
+        assert_gate_is_transparent(&source, "gfm", ParserOptions::gfm());
+    }
+}
