@@ -1,8 +1,8 @@
 //! Needle searches for the GFM autolink post-pass.
 //!
-//! Everything here is a pure scan over one string: the block-level
-//! pre-flight that decides whether the post-pass runs at all, and the
-//! per-text-node search for the earliest valid candidate.
+//! Everything here is a pure scan over one string: the document-level gate
+//! and the block-level pre-flight that decide whether the post-pass runs at
+//! all, and the per-text-node search for the earliest valid candidate.
 
 use std::sync::LazyLock;
 
@@ -38,6 +38,67 @@ const SCHEMES: [&str; 3] = ["https", "http", "ftp"];
 /// a `://` a candidate can begin.
 pub(super) const LONGEST_SCHEME: usize = 5;
 
+/// Which of the three autolink needles occur anywhere in a document.
+///
+/// Every verdict [`may_contain_autolink`] can reach needs `@`, `www.`, or
+/// `://` inside the block content it is handed, and the block parser never
+/// manufactures one: a sub-source is its parent's own bytes, copied whole
+/// lines at a time, with only spaces, line endings, and unescaped table
+/// pipes written between the copied runs — and none of those bytes occur in
+/// a needle, so no needle can straddle a join. A needle missing from the
+/// root source is therefore missing from every string that reaches the
+/// pre-flight, which makes these flags a superset of every block verdict in
+/// the document.
+#[derive(Clone, Copy)]
+pub(in crate::parser) struct AutolinkNeedles {
+    at: bool,
+    www: bool,
+    scheme: bool,
+}
+
+impl AutolinkNeedles {
+    /// "Every needle may occur": the state of a parser that never ran the
+    /// document scan, and the one that leaves each block check as it was.
+    pub(in crate::parser) const EVERY: Self = Self {
+        at: true,
+        www: true,
+        scheme: true,
+    };
+
+    /// Whether any block of this document can hold an autolink candidate.
+    pub(in crate::parser) const fn any(self) -> bool {
+        self.at || self.www || self.scheme
+    }
+}
+
+/// Records which autolink needles the whole document holds, once, so blocks
+/// of a document that holds none never run the pre-flight at all.
+///
+/// `://` is taken here without the markdown-destination exclusion that
+/// [`may_contain_autolink`] applies to it: a wider document verdict is still
+/// a superset, and the exclusion needs the surrounding block context that
+/// only the per-block scan has.
+pub(in crate::parser) fn scan_autolink_needles(source: &str) -> AutolinkNeedles {
+    let bytes = source.as_bytes();
+    let mut at = false;
+    let mut scheme = false;
+    for found in memchr::memchr2_iter(b'@', b':', bytes) {
+        if bytes[found] == b'@' {
+            at = true;
+        } else if bytes[found + 1..].starts_with(b"//") {
+            scheme = true;
+        }
+        if at && scheme {
+            break;
+        }
+    }
+    AutolinkNeedles {
+        at,
+        www: WWW_FINDER.find(bytes).is_some(),
+        scheme,
+    }
+}
+
 /// Cheap pre-flight over a block's raw inline content: can the autolink
 /// pass possibly rewrite anything here, and if so does it need the `www.`
 /// search at all?
