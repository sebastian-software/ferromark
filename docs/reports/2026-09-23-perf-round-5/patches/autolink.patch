+            scan.map(|scan| (scan.may_have_www, scan.may_have_extended))
+        };
+        assert_eq!(
+            answer(facts.finish(bytes)),
+            answer(may_contain_autolink(&source)),
+            "{source:?}"
+        );
+    }
