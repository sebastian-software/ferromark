@@ -0,0 +1,79 @@
+//! Characterize the opt-in cost of retaining image alternative content.
+
+use criterion::{BenchmarkId, Criterion, Throughput, criterion_group, criterion_main};
+use ferromark::{Allocator, HtmlRenderer, Parser, ParserOptions};
+use std::hint::black_box;
+
+fn options(retain: bool) -> ParserOptions {
+    ParserOptions {
+        image_alt_content: retain,
+        ..ParserOptions::gfm()
+    }
+}
+
+fn bench_image_alt_content(c: &mut Criterion) {
+    let mut group = c.benchmark_group("image_alt_content");
+    for (name, source) in [
+        (
+            "prose",
+            "A paragraph with **emphasis** and ordinary prose.\n\n".repeat(64),
+        ),
+        (
+            "plain",
+            "![A descriptive image label](image.png)\n\n".repeat(64),
+        ),
+        (
+            "rich",
+            "![Code `sample` and **é &amp; prose**](image.png)\n\n".repeat(64),
+        ),
+    ] {
+        let arena = Allocator::for_source_len(source.len());
+        let baseline = Parser::with_options(&arena, &source, options(false))
+            .parse()
+            .unwrap();
+        let candidate = Parser::with_options(&arena, &source, options(true))
+            .parse()
+            .unwrap();
+        assert_eq!(
+            HtmlRenderer::new().render(&baseline),
+            HtmlRenderer::new().render(&candidate)
+        );
+        group.throughput(Throughput::Bytes(source.len() as u64));
+        for retain in [false, true] {
+            // Keep all allocations in one pre-sized chunk, so consumed arena
+            // bytes are exactly initial capacity minus remaining capacity.
+            let arena = Allocator::with_capacity(source.len() * 128);
+            let capacity = arena.chunk_capacity();
+            let document = Parser::with_options(&arena, &source, options(retain))
+                .parse()
+                .unwrap();
+            assert_eq!(arena.allocated_bytes(), capacity);
+            #[allow(clippy::print_stderr)]
+            {
+                eprintln!(
+                    "arena {name} retain={retain}: {} bytes",
+                    capacity - arena.chunk_capacity()
+                );
+            }
+            black_box(document);
+            group.bench_with_input(
+                BenchmarkId::new(name, if retain { "on" } else { "off" }),
+                &source,
+                |b, source| {
+                    b.iter(|| {
+                        let arena = Allocator::for_source_len(source.len());
+                        black_box(
+                            Parser::with_options(&arena, black_box(source), options(retain))
+                                .parse()
+                                .unwrap(),
+                        );
+                    });
+                },
+            );
+        }
+    }
+    group.finish();
+}
+
+criterion_group!(benches, bench_image_alt_content);
+criterion_main!(benches);
diff --git a/examples/ast_metadata.rs b/examples/ast_metadata.rs
new file mode 100644
index 0000000..e0fe030
--- /dev/null
+++ b/examples/ast_metadata.rs
@@ -0,0 +1,65 @@
+//! Inspect image provenance and extract callout prose without structural markers.
+
+use ferromark::ast::{InlineCode, Node, Text, Visit};
+use ferromark::{Allocator, CalloutKind, Parser, ParserOptions};
+
+#[derive(Default)]
+struct Prose(String);
+impl<'a> Visit<'a> for Prose {
+    fn visit_text(&mut self, text: &Text<'a>) {
+        self.0.push_str(text.value);
+    }
+    fn visit_inline_code(&mut self, code: &InlineCode<'a>) {
+        self.0.push_str(code.value);
+    }
+}
+
+fn main() -> Result<(), ferromark::ParseError> {
+    let source =
+        "![Code `sample`](sample.png)\n\n> [!NOTE]\n> Keep this **note**.\n>\n> Second paragraph.";
+    let arena = Allocator::new();
+    let document = Parser::with_options(
+        &arena,
+        source,
+        ParserOptions {
+            image_alt_content: true,
+            ..ParserOptions::gfm()
+        },
+    )
+    .parse()?;
+    let Node::Paragraph(paragraph) = &document.children[0] else {
+        unreachable!()
+    };
+    let Node::Image(image) = &paragraph.children[0] else {
+        unreachable!()
+    };
+    assert_eq!(image.alt, "Code sample");
+    let alt = image.alt_content.as_ref().unwrap();
+    let Node::InlineCode(code) = &alt.children[1] else {
+        unreachable!()
+    };
+    assert_eq!(code.span.source_text(source), "`sample`");
+
+    let Node::BlockQuote(quote) = &document.children[1] else {
+        unreachable!()
+    };
+    let callout = quote.callout(source).unwrap();
+    assert_eq!(callout.kind, CalloutKind::Note);
+    assert_eq!(callout.marker_span.source_text(source), "[!NOTE]");
+    let mut prose = Prose::default();
+    for (index, node) in callout.body.inlines.iter().enumerate() {
+        if index == 0
+            && let Node::Text(text) = node
+        {
+            prose.0.push_str(&text.value[callout.body.text_offset..]);
+        } else {
+            prose.visit_node(node);
+        }
+    }
+    for block in callout.body.blocks {
+        prose.0.push('\n');
+        prose.visit_node(block);
+    }
+    assert_eq!(prose.0, "Keep this note.\nSecond paragraph.");
+    Ok(())
+}
