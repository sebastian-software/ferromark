     }
 }
 
+#[test]
+fn url_escape_copies_runs_of_every_length_intact() {
+    // URL runs are ASCII by construction, but they are cut out of the byte
+    // slice and copied by the same helper as text runs, so they still cross
+    // its strategy boundaries at 16 and 64 bytes. Bracket each length with a
+    // replacement, a percent-encoded character and nothing at all.
+    for len in [0usize, 1, 15, 16, 17, 31, 32, 33, 63, 64, 65, 127, 200] {
+        let run = "u".repeat(len);
+        for source in [
+            run.clone(),
+            format!("https://example.com/{run}"),
+            format!("{run} {run}"),
+            format!("&{run}&"),
+            format!("é{run}é"),
+        ] {
+            let mut actual = String::new();
+            write_url_escaped_into(&mut actual, &source);
+            assert_eq!(actual, reference_url(&source), "source: {source:?}");
+            assert!(
+                std::str::from_utf8(actual.as_bytes()).is_ok(),
+                "url escape produced invalid UTF-8 for {source:?}"
+            );
+        }
+    }
+}
