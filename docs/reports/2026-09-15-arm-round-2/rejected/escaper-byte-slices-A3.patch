@@ -64,37 +64,52 @@ const fn url_escape_mask(word: u64) -> u64 {
 /// byte by byte just to bound its ASCII runs. Percent encoding operates on
 /// the UTF-8 bytes, as required by cmark's URI renderer, and leaves existing
 /// `%HH` sequences alone.
+///
+/// As in the text escaper, runs are cut out of the byte slice: the scanner
+/// has already classified the bytes bounding them, so `is_char_boundary`
+/// would only re-prove what the loop knows. It is worth more here — a URL
+/// flags a byte every few positions, so the checks land once per run in a
+/// loop whose runs are short.
+#[allow(unsafe_code)]
 pub(super) fn write_url_segment(out: &mut String, s: &str) {
     let bytes = s.as_bytes();
     let mut start = 0usize;
-    loop {
-        let i = next_url_flagged(bytes, start);
-        if i >= bytes.len() {
-            break;
-        }
-        if start < i {
-            push_run(out, &s[start..i]);
-        }
-        let byte = bytes[i];
-        if byte >= 0x80 {
-            // `start` sits on a char boundary and this is the first non-ASCII
-            // byte after it, so the run begins at a leading byte and ends at
-            // the next ASCII byte or the end of the string.
-            let unicode_end = bytes[i..]
-                .iter()
-                .position(|&byte| byte < 0x80)
-                .map_or(bytes.len(), |offset| i + offset);
-            for &byte in &bytes[i..unicode_end] {
-                push_percent_byte(out, byte);
+
+    // SAFETY: a run ends at a flagged byte and starts at zero, one past a
+    // flagged ASCII byte, or at the ASCII byte ending a percent-encoded
+    // non-ASCII run — all char boundaries of `s`, so no run splits a
+    // multi-byte character. Replacements and percent escapes are ASCII, so
+    // `out` keeps ending on a char boundary as well.
+    unsafe {
+        loop {
+            let i = next_url_flagged(bytes, start);
+            if i >= bytes.len() {
+                break;
+            }
+            if start < i {
+                push_run(out, &bytes[start..i]);
+            }
+            let byte = bytes[i];
+            if byte >= 0x80 {
+                // `start` sits on a char boundary and this is the first
+                // non-ASCII byte after it, so the run begins at a leading byte
+                // and ends at the next ASCII byte or the end of the string.
+                let unicode_end = bytes[i..]
+                    .iter()
+                    .position(|&byte| byte < 0x80)
+                    .map_or(bytes.len(), |offset| i + offset);
+                for &byte in &bytes[i..unicode_end] {
+                    push_percent_byte(out, byte);
+                }
+                start = unicode_end;
+            } else {
+                push_run(out, URL_ESCAPE_TABLE[byte as usize].as_bytes());
+                start = i + 1;
             }
-            start = unicode_end;
-        } else {
-            push_run(out, URL_ESCAPE_TABLE[byte as usize]);
-            start = i + 1;
         }
-    }
-    if start < bytes.len() {
-        push_run(out, &s[start..]);
+        if start < bytes.len() {
+            push_run(out, &bytes[start..]);
+        }
     }
 }
 
diff --git a/crates/ferromark/src/renderer/html/escape/url/tests.rs b/crates/ferromark/src/renderer/html/escape/url/tests.rs
