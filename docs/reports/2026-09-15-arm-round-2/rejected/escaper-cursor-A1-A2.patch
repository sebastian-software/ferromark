+++ b/crates/ferromark/src/renderer/html/escape/tests.rs
@@ -20,14 +20,36 @@ fn reference(s: &str, flags: &[u8; 256], table: &[&'static str; 256]) -> String
     String::from_utf8(out).expect("escaping only rewrites ASCII bytes")
 }
 
+/// Independent oracle for text escaping: a `match` over the five bytes the
+/// renderer replaces, with every other byte copied through verbatim.
+///
+/// Unlike [`reference`] it shares no table with the implementation, so a
+/// mis-packed replacement word or a table indexed with the wrong byte shows
+/// up here even though both sides would agree on a shared table.
+fn text_oracle(s: &str) -> String {
+    let mut out: Vec<u8> = Vec::new();
+    for byte in s.bytes() {
+        match byte {
+            b'&' => out.extend_from_slice(b"&amp;"),
+            b'<' => out.extend_from_slice(b"&lt;"),
+            b'>' => out.extend_from_slice(b"&gt;"),
+            b'"' => out.extend_from_slice(b"&quot;"),
+            b'\'' => out.extend_from_slice(b"&#39;"),
+            other => out.push(other),
+        }
+    }
+    String::from_utf8(out).expect("escaping only rewrites ASCII bytes")
+}
+
 fn check(s: &str) {
     let mut text = String::new();
     write_escaped_into(&mut text, s);
     assert_eq!(
         text,
-        reference(s, &ESCAPE_FLAG, &ESCAPE_TABLE),
+        reference(s, &ESCAPE_FLAG, &ESCAPE_STRINGS),
         "text escape: {s:?}"
     );
+    assert_eq!(text, text_oracle(s), "text oracle: {s:?}");
 
     let mut url = String::new();
     write_url_escaped_into(&mut url, s);
@@ -93,7 +115,7 @@ fn runs_of_every_length_are_copied_intact() {
                 out,
                 format!(
                     "existing-content{}",
-                    reference(&source, &ESCAPE_FLAG, &ESCAPE_TABLE)
+                    reference(&source, &ESCAPE_FLAG, &ESCAPE_STRINGS)
                 )
             );
         }
@@ -214,3 +236,91 @@ fn short_run_copy_keeps_multibyte_sequences_intact() {
         }
     }
 }
+
+#[test]
+fn matches_the_oracle_for_every_output_capacity_shape() {
+    // The escaper reserves once on entry and then writes through a raw
+    // cursor, so the interesting outputs are the ones where that reserve is
+    // not the whole story: an output with no spare capacity at all, one sized
+    // exactly for the source, and ones whose replacements push the write past
+    // the reserve and into the cursor's growth path. Each source is escaped
+    // into all of those shapes, with and without content already present.
+    let mut sources: Vec<String> = vec![
+        String::new(),
+        "a".into(),
+        "&".into(),
+        "'".into(),
+        "\"".into(),
+        "&<>\"'".into(),
+        "&&&&&&&&&&&&&&&&&&&&".into(),
+        "plain ascii text with no escapes at all".into(),
+        "日本語 & <tags> 🙂".into(),
+    ];
+    for len in [1usize, 3, 7, 8, 15, 16, 17, 31, 32, 33, 64, 65, 200] {
+        let run = "x".repeat(len);
+        sources.push(format!("&{run}&"));
+        sources.push(format!("{run}\""));
+        sources.push("<x".repeat(len));
+        sources.push(run);
+    }
+
+    for source in &sources {
+        let expected = text_oracle(source);
+        for prefix in ["", "already here"] {
+            for spare in [
+                0,
+                1,
+                source.len() / 2,
+                source.len(),
+                source.len() + 1,
+                expected.len(),
+                expected.len() + 64,
+            ] {
+                let mut out = String::with_capacity(prefix.len() + spare);
+                out.push_str(prefix);
+                let spare_before = out.capacity() - out.len();
+                write_escaped_into(&mut out, source);
+                assert_eq!(
+                    out,
+                    format!("{prefix}{expected}"),
+                    "source {source:?} into an output holding {prefix:?} with {spare_before} spare"
+                );
+            }
+        }
+    }
+}
+
+#[test]
+fn matches_the_oracle_on_pseudorandom_bytes_from_the_whole_byte_range() {
+    // `matches_reference_on_pseudorandom_bytes` stays inside printable ASCII
+    // plus the needles. This one draws from all 256 values, so continuation
+    // bytes, control bytes and sequences the lossy conversion rewrites land
+    // next to escapes at every alignment and every length.
+    let mut state = 0x8765_4321_0fed_cba9u64;
+    for len in 0..200usize {
+        let mut buffer = Vec::with_capacity(len);
+        for _ in 0..len {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            buffer.push((state >> 24) as u8);
+        }
+        check(&String::from_utf8_lossy(&buffer));
+    }
+}
+
+#[test]
+fn packed_replacements_decode_to_the_replacement_strings() {
+    // A replacement is written as one eight-byte store followed by an advance
+    // of the length packed into the top lane. Decoding every entry keeps that
+    // packing honest against the strings the table is written from.
+    for byte in 0..=255usize {
+        let lanes = ESCAPE_WORDS[byte].to_le_bytes();
+        let len = usize::from(lanes[7]);
+        assert_eq!(
+            &lanes[..len],
+            ESCAPE_STRINGS[byte].as_bytes(),
+            "packed replacement for byte {byte:#04x}"
+        );
+    }
+}
