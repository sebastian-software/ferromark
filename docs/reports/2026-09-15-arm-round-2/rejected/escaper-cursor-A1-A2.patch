diff --git a/crates/ferromark/src/renderer/html/escape/cursor.rs b/crates/ferromark/src/renderer/html/escape/cursor.rs
new file mode 100644
index 00000000..7bf9efa4
--- /dev/null
+++ b/crates/ferromark/src/renderer/html/escape/cursor.rs
@@ -0,0 +1,274 @@
+//! Raw output cursor shared by the escape loops.
+//!
+//! An escaper emits its result in many short pieces: a clean run, a short
+//! replacement, another run. Appending each piece through `String` re-reads
+//! the length and capacity from memory, branches on whether the piece fits,
+//! and writes the new length back — once per piece, however short the piece
+//! is. On documentation-style corpora that bookkeeping shows up in profiles
+//! next to the copies it guards, because a text node is short and a
+//! replacement is five bytes at most.
+//!
+//! [`Cursor`] hoists it out of the loop. One `reserve` per escaper call sizes
+//! the output for the no-escape case, the write pointer and the spare byte
+//! count then stay in registers for the rest of the call, and the string's
+//! length is written back once at the end. Only growth touches the `String`
+//! again; that path is cold and out of line, and it commits the bytes written
+//! so far *before* reserving, so the length never covers bytes that were not
+//! written and the string stays valid UTF-8 even if the reserve unwinds.
+
+/// Bit position of the length byte inside a packed replacement.
+const LEN_SHIFT: u32 = 56;
+
+/// Longest replacement that still leaves the top lane free for the length.
+/// The longest one either escaper emits is `&quot;` at six bytes.
+const MAX_REPLACEMENT: usize = 7;
+
+/// Packs a replacement string into one word: its bytes in the low lanes, its
+/// length in the top lane.
+///
+/// A replacement is at most [`MAX_REPLACEMENT`] bytes, so the length lane
+/// never collides with the text, and a table of these words is half the size
+/// of the equivalent `[&str; 256]` of fat pointers while keeping the bytes
+/// themselves in the table instead of in a separate rodata string. Writing a
+/// replacement is then one unaligned eight-byte store plus an advance by the
+/// packed length: no length-dependent branch, no second load.
+pub(super) const fn pack_replacement(s: &str) -> u64 {
+    let bytes = s.as_bytes();
+    assert!(
+        bytes.len() <= MAX_REPLACEMENT,
+        "replacement is too long to pack"
+    );
+    let mut word = (bytes.len() as u64) << LEN_SHIFT;
+    let mut i = 0;
+    while i < bytes.len() {
+        word |= (bytes[i] as u64) << (8 * i as u32);
+        i += 1;
+    }
+    word
+}
+
+/// Packs a whole byte-indexed replacement table. Unused entries pack to zero,
+/// which writes nothing and advances nothing.
+pub(super) const fn pack_table(strings: &[&str; 256]) -> [u64; 256] {
+    let mut table = [0u64; 256];
+    let mut i = 0;
+    while i < 256 {
+        table[i] = pack_replacement(strings[i]);
+        i += 1;
+    }
+    table
+}
+
+/// A write pointer into a `String`'s spare capacity.
+///
+/// The string's length stays at the value it had when the cursor was created
+/// (or at the last growth) until [`Cursor::finish`], so no intermediate state
+/// of the string is ever observable and none of the writes below have to
+/// update it.
+pub(super) struct Cursor<'a> {
+    /// The output. Untouched between growths.
+    out: &'a mut String,
+    /// Next byte to write; `out.len() + written` bytes into the buffer.
+    dst: *mut u8,
+    /// Spare capacity left at `dst`.
+    remaining: usize,
+    /// Value `remaining` had when the length was last committed. The
+    /// difference to `remaining` is the number of uncommitted bytes, which
+    /// avoids re-reading the buffer pointer to recover it.
+    spare: usize,
+}
+
+impl<'a> Cursor<'a> {
+    /// Reserves `additional` bytes and takes a cursor to the spare capacity.
+    #[allow(unsafe_code)]
+    #[inline]
+    pub(super) fn new(out: &'a mut String, additional: usize) -> Self {
+        out.reserve(additional);
+
+        // SAFETY: the vector is only read here — `len` and `capacity` are
+        // taken without changing either, so the string is still the valid
+        // UTF-8 it was on entry. `len <= capacity`, so the write pointer is at
+        // most one past the end of the buffer, and `remaining` counts exactly
+        // the spare bytes at it.
+        let (dst, remaining) = unsafe {
+            let vec = out.as_mut_vec();
+            let len = vec.len();
+            (vec.as_mut_ptr().add(len), vec.capacity() - len)
+        };
+
+        Self {
+            out,
+            dst,
+            remaining,
+            spare: remaining,
+        }
+    }
+
+    /// Commits the bytes written so far and makes room for `need` more.
+    ///
+    /// Out of line and cold: the escapers reserve for the no-escape case up
+    /// front, so this runs only when replacements push the output past that.
+    #[allow(unsafe_code)]
+    #[cold]
+    #[inline(never)]
+    fn grow(&mut self, need: usize) {
+        let written = self.spare - self.remaining;
+
+        // SAFETY: `written` bytes were written at the end of the buffer by the
+        // methods below, each of them a whole run or a whole replacement, so
+        // extending the length by it covers initialized bytes only and ends on
+        // a char boundary. The reserve comes after that commit, so an unwind
+        // from it leaves a valid, merely shorter string. Afterwards the buffer
+        // pointer and capacity are re-read from the same vector, which keeps
+        // the cursor's invariants across a reallocation.
+        unsafe {
+            let vec = self.out.as_mut_vec();
+            let len = vec.len() + written;
+            vec.set_len(len);
+            vec.reserve(need);
+            self.dst = vec.as_mut_ptr().add(len);
+            self.remaining = vec.capacity() - len;
+        }
+
+        self.spare = self.remaining;
+    }
+
+    /// Records `len` written bytes.
+    ///
+    /// # Safety
+    ///
+    /// `len` bytes must have just been written at `dst`, and `len` must not
+    /// exceed `remaining`.
+    #[allow(unsafe_code)]
+    #[inline]
+    unsafe fn advance(&mut self, len: usize) {
+        // SAFETY: the caller guarantees `len <= self.remaining`, so the new
+        // pointer stays inside the buffer or one past its end.
+        self.dst = unsafe { self.dst.add(len) };
+        self.remaining -= len;
+    }
+
+    /// Appends a packed replacement produced by [`pack_replacement`].
+    ///
+    /// The store is a fixed eight bytes regardless of the replacement's
+    /// length, so the spare capacity is topped up to eight first; the bytes
+    /// past the replacement land in spare capacity the next write overwrites.
+    #[allow(unsafe_code)]
+    #[inline]
+    pub(super) fn push_replacement(&mut self, packed: u64) {
+        if self.remaining < 8 {
+            self.grow(8);
+        }
+        let len = (packed >> LEN_SHIFT) as usize;
+
+        // SAFETY: `remaining >= 8` here, so all eight bytes land in spare
+        // capacity, and the low `len <= MAX_REPLACEMENT < 8` of them are the
+        // replacement text `advance` then commits. Replacements are ASCII, so
+        // the result stays valid UTF-8.
+        unsafe {
+            std::ptr::copy_nonoverlapping(packed.to_le_bytes().as_ptr(), self.dst, 8);
+            self.advance(len);
+        }
+    }
+
+    /// Appends a run of clean bytes, copying short runs inline instead of
+    /// handing them to `memmove`.
+    ///
+    /// Half of the byte runs the escapers copy are under 16 bytes long — text
+    /// nodes are short, and the gap between two escapes is shorter still. At
+    /// that size libc's `memmove` spends most of its time picking a strategy,
+    /// and `push_str` cannot avoid it: any length the compiler cannot see
+    /// lowers to a `memcpy` call. Two overlapping loads and stores cover every
+    /// run up to 16 bytes with no length-dependent branching inside the copy.
+    #[allow(unsafe_code)]
+    #[inline]
+    pub(super) fn push_run(&mut self, src: &str) {
+        let len = src.len();
+        if len > 16 {
+            self.push_run_long(src);
+            return;
+        }
+        if self.remaining < len {
+            self.grow(len);
+        }
+
+        // SAFETY: `remaining >= len` here and every write below lands inside
+        // `[0, len)` of the spare capacity, which is what `advance` commits.
+        // `src` is a `&str` appended at the end of `out`, which is a char
+        // boundary, so the result stays valid UTF-8. The two pointers cannot
+        // overlap: `out` is borrowed uniquely, so no live `&str` can alias its
+        // buffer.
+        unsafe {
+            let dst = self.dst;
+            let src = src.as_ptr();
+            if len >= 8 {
+                std::ptr::copy_nonoverlapping(src, dst, 8);
+                std::ptr::copy_nonoverlapping(src.add(len - 8), dst.add(len - 8), 8);
+            } else if len >= 4 {
+                std::ptr::copy_nonoverlapping(src, dst, 4);
+                std::ptr::copy_nonoverlapping(src.add(len - 4), dst.add(len - 4), 4);
+            } else if len > 0 {
+                *dst = *src;
+                *dst.add(len / 2) = *src.add(len / 2);
+                *dst.add(len - 1) = *src.add(len - 1);
+            }
+            self.advance(len);
+        }
+    }
+
+    /// Appends a run longer than 16 bytes.
+    ///
+    /// Runs of 17-64 bytes — the prose between two escaped bytes, most `href`
+    /// values — are still short enough that `memmove` spends most of its time
+    /// choosing a strategy, so they are copied with two or four overlapping
+    /// 16-byte moves instead. Longer runs go to `memcpy`. This stays out of
+    /// line on purpose, together with its growth check: inlining the wider
+    /// copies into the escape loops made their bodies larger and measurably
+    /// slowed escape-dense code blocks.
+    #[allow(unsafe_code)]
+    #[inline(never)]
+    fn push_run_long(&mut self, src: &str) {
+        let len = src.len();
+        if self.remaining < len {
+            self.grow(len);
+        }
+
+        // SAFETY: `remaining >= len` here; `len` is at least 17, so every
+        // 16-byte block below lands inside `[0, len)` of the spare capacity,
+        // which is what `advance` commits. `src` is a `&str` appended at a
+        // char boundary, so the result stays valid UTF-8, and the buffers
+        // cannot overlap because `out` is borrowed uniquely.
+        unsafe {
+            let dst = self.dst;
+            let src = src.as_ptr();
+            if len > 64 {
+                std::ptr::copy_nonoverlapping(src, dst, len);
+            } else {
+                std::ptr::copy_nonoverlapping(src, dst, 16);
+                std::ptr::copy_nonoverlapping(src.add(len - 16), dst.add(len - 16), 16);
+                if len > 32 {
+                    std::ptr::copy_nonoverlapping(src.add(16), dst.add(16), 16);
+                    std::ptr::copy_nonoverlapping(src.add(len - 32), dst.add(len - 32), 16);
+                }
+            }
+            self.advance(len);
+        }
+    }
+
+    /// Commits everything written through the cursor to the output's length.
+    #[allow(unsafe_code)]
+    #[inline]
+    pub(super) fn finish(self) {
+        let written = self.spare - self.remaining;
+
+        // SAFETY: as in `grow`, `written` counts bytes this cursor wrote at
+        // the end of the buffer as whole runs and whole replacements, so the
+        // committed length covers initialized bytes only and ends on a char
+        // boundary.
+        unsafe {
+            let vec = self.out.as_mut_vec();
+            let len = vec.len() + written;
+            vec.set_len(len);
+        }
+    }
+}
