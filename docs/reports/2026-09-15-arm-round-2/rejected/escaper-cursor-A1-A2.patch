+/// Packs the `%HH` escape of `byte` in the same layout.
+///
+/// Percent encoding applies to the 128 non-ASCII bytes, and deriving their
+/// words from a 16-byte hex table instead of storing a second 256-entry table
+/// keeps the escapers' constant data small while still writing each escape as
+/// one store.
+#[inline]
+pub(super) const fn pack_percent(byte: u8) -> u64 {
+    const HEX: [u8; 16] = *b"0123456789ABCDEF";
+    let high = HEX[(byte >> 4) as usize] as u64;
+    let low = HEX[(byte & 0x0F) as usize] as u64;
+    (b'%' as u64) | (high << 8) | (low << 16) | (3 << LEN_SHIFT)
+}
