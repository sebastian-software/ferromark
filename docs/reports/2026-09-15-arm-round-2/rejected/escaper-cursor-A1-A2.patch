+#[test]
+fn url_escape_matches_the_oracle_for_every_output_capacity_shape() {
+    // The segment escaper reserves once and then writes through a raw
+    // cursor, so the shapes that matter are the ones where that reserve runs
+    // out: percent encoding triples the length of every non-ASCII byte, and
+    // `&` alone expands fivefold. Each source is escaped into outputs with no
+    // spare capacity, with exactly the source's length, and with room for the
+    // whole result, with and without content already present.
+    let mut sources: Vec<String> = vec![
+        String::new(),
+        "https://example.com/path?query=1#frag".into(),
+        "&".into(),
+        " [`]\\ ".into(),
+        "https://example.com/日本語/🙂?q=a b".into(),
+        // No IPv6 authority here: that path is split around the brackets
+        // before the segments are escaped, which the oracle does not model.
+        "https://example.com/path with spaces".into(),
+        "%41%42%43".into(),
+    ];
+    for len in [1usize, 7, 8, 15, 16, 17, 33, 64, 65, 200] {
+        let run = "u".repeat(len);
+        sources.push(format!("é{run}é"));
+        sources.push(format!("{run}&{run}"));
+        sources.push("&é".repeat(len));
+        sources.push(run);
+    }
+
+    for source in &sources {
+        let expected = reference_url(source);
+        for prefix in ["", "already here"] {
+            for spare in [
+                0,
+                1,
+                source.len(),
+                source.len() + 1,
+                expected.len(),
+                expected.len() + 64,
+            ] {
+                let mut out = String::with_capacity(prefix.len() + spare);
+                out.push_str(prefix);
+                let spare_before = out.capacity() - out.len();
+                write_url_escaped_into(&mut out, source);
+                assert_eq!(
+                    out,
+                    format!("{prefix}{expected}"),
+                    "source {source:?} into an output holding {prefix:?} with {spare_before} spare"
+                );
+            }
+        }
+    }
+}
+
+#[test]
+fn url_escape_matches_the_oracle_on_pseudorandom_bytes() {
+    // Random bytes put percent escapes, table replacements and clean runs at
+    // every alignment, including lengths that straddle the vector step and
+    // the eight-byte walk after a hit.
+    let mut state = 0x1234_5678_9abc_def1u64;
+    for len in 0..200usize {
+        let mut buffer = Vec::with_capacity(len);
+        for _ in 0..len {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            buffer.push((state >> 24) as u8);
+        }
+        let source = String::from_utf8_lossy(&buffer);
+        let mut actual = String::new();
+        write_url_escaped_into(&mut actual, &source);
+        assert_eq!(actual, reference_url(&source), "source: {source:?}");
+    }
+}
+
+#[test]
+fn packed_url_replacements_decode_to_the_replacement_strings() {
+    // The cursor writes a replacement as one eight-byte store and advances by
+    // the length packed into the top lane, for table entries and for the
+    // percent escapes alike.
+    const HEX: &[u8; 16] = b"0123456789ABCDEF";
+    for byte in 0..=255usize {
+        let lanes = URL_ESCAPE_WORDS[byte].to_le_bytes();
+        let len = usize::from(lanes[7]);
+        assert_eq!(
+            &lanes[..len],
+            URL_ESCAPE_STRINGS[byte].as_bytes(),
+            "packed replacement for byte {byte:#04x}"
+        );
+
+        let percent = pack_percent(byte as u8).to_le_bytes();
+        assert_eq!(usize::from(percent[7]), 3);
+        assert_eq!(
+            &percent[..3],
+            &[b'%', HEX[byte >> 4], HEX[byte & 0x0F]],
+            "percent escape for byte {byte:#04x}"
+        );
+    }
+}
