+#[cfg(test)]
+thread_local! {
+    /// Test-only switch onto the original two-scan path.
+    static RECORDING_DISABLED: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+#[cfg(test)]
+fn recording_enabled() -> bool {
+    RECORDING_DISABLED.with(|disabled| !disabled.get())
+}
+
+#[cfg(not(test))]
+const fn recording_enabled() -> bool {
+    true
