+// --- whole-document differential parses -----------------------------------
+
+fn debug_parse(source: &str, options: &ParserOptions) -> String {
+    let allocator = Allocator::new();
+    match Parser::with_options(&allocator, source, options.clone()).parse() {
+        Ok(document) => format!("{document:#?}"),
+        Err(error) => format!("{error:?}"),
+    }
+}
+
+fn html(source: &str, options: &ParserOptions) -> String {
+    crate::to_html_with_options(
+        source,
+        options.clone(),
+        crate::HtmlRendererOptions::default(),
+    )
+    .unwrap_or_default()
+}
+
+fn assert_same_parse(source: &str, options: &ParserOptions, label: &str) {
+    let recorded = debug_parse(source, options);
+    let scanned = without_recording(|| debug_parse(source, options));
+    assert_eq!(recorded, scanned, "AST differs: {label}");
+    let recorded = html(source, options);
+    let scanned = without_recording(|| html(source, options));
+    assert_eq!(recorded, scanned, "HTML differs: {label}");
+}
+
+/// Option profiles that change either the marker set or the line scan.
+fn profiles() -> Vec<(&'static str, ParserOptions)> {
+    let mut profiles = vec![
+        ("commonmark", ParserOptions::commonmark()),
+        ("gfm", ParserOptions::gfm()),
+        ("mdx", ParserOptions::mdx()),
+        (
+            "line-comments",
+            ParserOptions {
+                line_comments: true,
+                ..ParserOptions::gfm()
+            },
+        ),
+        (
+            "everything",
+            ParserOptions {
+                highlight: true,
+                inline_footnotes: true,
+                superscript: true,
+                subscript: true,
+                math: true,
+                definition_lists: true,
+                heading_attributes: true,
+                wiki_links: true,
+                merged_table_cells: true,
+                table_attributes: true,
+                line_comments: true,
+                mdx: true,
+                ..ParserOptions::gfm()
+            },
+        ),
+    ];
+    // Every optional-marker combination, with and without the table scan.
+    for mask in 0..=15u8 {
+        for tables in [false, true] {
+            profiles.push((
+                "mask",
+                ParserOptions {
+                    inline_footnotes: mask & 2 != 0,
+                    ..options_for(mask, tables)
+                },
+            ));
+        }
+    }
+    profiles
+}
+
+/// Hand-written shapes that put the line scan and the memo under stress.
+const CORPUS: &[&str] = &[
+    "",
+    "plain paragraph",
+    "  indented paragraph with three spaces\n  and a second line",
+    "first\nsecond\nthird",
+    "hard break  \nnext line",
+    "backslash break\\\nnext line",
+    "trailing tab\t\nnext line",
+    "a\r\nb\r\nc",
+    "a\rb\rc",
+    "mixed\r\nendings\nand\rmore\r\n",
+    "tabs\tin\tthe\tmiddle\nand\tmore",
+    "unicode é 中文 🎉 text with *emphasis* and `code`",
+    "setext heading\n===",
+    "setext heading\n---",
+    "para\nstill para\n---\nafter",
+    "| not | a | table",
+    "a | pipe in prose\nand another | here",
+    "| head | row |\n| --- | --- |\n| a | b |",
+    "para before\n| head | row |\n| --- | --- |\n| a | b |",
+    "text | with pipe\ncontinued | line\n\nnext",
+    "para\n# heading interrupts",
+    "para\n> quote interrupts",
+    "para\n- list interrupts",
+    "para\n1. ordered interrupts",
+    "para\n```\nfence\n```",
+    "para\n~~~\nfence\n~~~",
+    "para\n***",
+    "para\n<div>\nhtml\n</div>",
+    "para\n    indented continuation is lazy",
+    "> quote paragraph\nlazy continuation of the quote\n\nafter",
+    "- list item paragraph\nlazy continuation\n\nafter",
+    "> - nested\n> continued lazily\ncompletely lazy",
+    "[ref]: /url\n\nuse [ref] here\n\n[ref]: /other",
+    "[^note]: body\n\nsee[^note] here",
+    "text ^[inline note] and ^sup^ and ~sub~ and ==mark== and $math$ and {expr}",
+    "== surrounded == equals ==pair==",
+    "^ lone caret ^[note] ^^double^^",
+    "a *b* _c_ `d` [e](f) ![g](h) <i> & ~j~ \\k",
+    "&amp; &#65; &notanentity; &",
+    "<https://example.com> and https://example.com bare",
+    "line with <a href=\"x\">tag</a> inline\nsecond line <b>bold</b>",
+    "{jsx} <Component /> and <Component>child</Component>",
+    "// comment line\nparagraph after comment\n// trailing comment",
+    "paragraph\n// middle comment\nmore paragraph",
+    "para with trailing comment\n// tail",
+    ": definition body\n\nterm\n: definition",
+    "$$\ndisplay math\n$$\n\npara",
+    "$$ unterminated display math\ncontinues as paragraph",
+    // `trim` removes Unicode whitespace, so the translation from source
+    // offsets to content offsets has to follow the real trim, not the
+    // space/tab indent the block dispatcher measured.
+    "\u{a0}nbsp leads the paragraph\nsecond *line*",
+    "\u{b}vertical tab leads\nsecond line",
+    "\u{c}form feed leads *the* line",
+    "para *one*\u{a0}\ntrailing nbsp after markers \u{a0}",
+    "  \u{a0} *mixed* leading whitespace\n  \u{a0} and again",
+    "\u{feff}bom paragraph",
+    "nul\0byte paragraph",
+    "   \t  \n\n   leading blanks then text",
+    "para ending at EOF without newline",
+    "*",
+    "|",
+    "\n\n\n",
+];
+
+fn generated() -> Vec<String> {
+    let mut documents = Vec::new();
+
+    // A long-line encyclopedia shape: many markers, one very long line.
+    let mut article = String::new();
+    for paragraph in 0..12 {
+        for sentence in 0..8 {
+            article.push_str(
+                "The subject is described in the literature as a [notable](https://example.com/x) ",
+            );
+            article.push_str("case of *emphasis*, `inline code`, and _underscores_; see also ");
+            article.push_str("<https://example.org> and the note & the caveat. ");
+            if sentence % 3 == 0 {
+                article.push_str("A pipe | appears here too. ");
+            }
+        }
+        article.push('\n');
+        if paragraph % 2 == 0 {
+            article.push_str("A second line of the same paragraph continues the thought.\n");
+        }
+        article.push('\n');
+    }
+    documents.push(article);
+
+    // The same content with CRLF endings.
+    documents.push(documents[0].replace('\n', "\r\n"));
+
+    // Very short lines: the shape most likely to be sensitive to per-line
+    // bookkeeping rather than per-byte scanning.
+    let mut short = String::new();
+    for index in 0..400 {
+        short.push_str(if index % 7 == 0 { "*a*" } else { "ab" });
+        short.push('\n');
+        if index % 13 == 0 {
+            short.push('\n');
+        }
+    }
+    documents.push(short);
+
+    // Marker-dense text: every byte a candidate.
+    let mut dense = String::new();
+    for index in 0..500 {
+        dense.push(b"*_`[!~\\<&{^$=|"[index % 14] as char);
+        if index % 40 == 39 {
+            dense.push('\n');
+        }
+    }
+    documents.push(dense);
+
+    // A paragraph longer than the memo's inline capacity, so the spill path
+    // and the reuse of the spilled buffer both run.
+    let mut spill = String::new();
+    for index in 0..900 {
+        spill.push_str("word ");
+        if index % 5 == 0 {
+            spill.push_str("*em* ");
+        }
+    }
+    spill.push_str("\n\nsecond paragraph *with* markers\n");
+    documents.push(spill);
+
+    // Paragraphs interrupted by every block starter, each after a paragraph
+    // line that the memo has already recorded.
+    for interrupt in [
+        "# atx",
+        "> quote",
+        "- bullet",
+        "+ bullet",
+        "1. ordered",
+        "```fence",
+        "~~~fence",
+        "***",
+        "---",
+        "___",
+        "<div>",
+        "<!-- c -->",
+        ": body",
+        "    code",
+        "$$",
+        "{expr}",
+        "import a from 'b'",
+        "| a |\n| - |",
+    ] {
+        documents.push(format!("paragraph line one\nline two\n{interrupt}\ntail"));
+        documents.push(format!("> quoted paragraph\n> {interrupt}\n\ntail"));
+        documents.push(format!("- item paragraph\n  {interrupt}\n\ntail"));
+    }
+
+    // Deeply nested lazy continuation, where sub-parsers build their own memo.
+    documents.push(
+        "> > > deep quote paragraph\nlazy one\nlazy two\n\n- > item quote\n  lazy three\n"
+            .to_string(),
+    );
+
+    documents
+}
