new file mode 100644
index 00000000..fb7199c2
--- /dev/null
+++ b/crates/ferromark/src/parser/line_markers.rs
@@ -0,0 +1,413 @@
+//! Block-level line scanning that also records the line's inline markers.
+//!
+//! Paragraph text used to be read by two vector scans. Block parsing walked
+//! each line to find its end — and, with tables enabled, to look for a `|` —
+//! and inline parsing then ran the marker classifier over the very same
+//! bytes. The two scans ask different questions of the same pass: "where does
+//! this line end", "does it hold a pipe", and "where are the bytes that can
+//! begin an inline construct".
+//!
+//! [`MarkerMemo`] answers all three at once. It classifies with the same
+//! option-selected nibble tables [`crate::parser::inline`] uses, so the
+//! positions it records are exactly the positions the inline scan would have
+//! found, appends them to a stack-resident buffer, stops at the first line
+//! ending, and reports whether a `|` came before it. The paragraph's inline
+//! pass then replays the recording instead of classifying the bytes again.
+//!
+//! Only the classifier is shared, not the decision: recorded positions are
+//! candidates, and the same filtering the on-demand scan applies still runs
+//! over the block's own content slice.
+
+use smallvec::SmallVec;
+
+use super::inline::{
+    PIPE_TABLE_BIT, PIPE_TABLE_INDEX, optional_marker_bits, selected_marker_tables,
+};
+use super::line_scan::line_terminator_end;
+
+/// Marker offsets held without spilling to the heap.
+///
+/// One `u32` per marker byte. Prose on the bundled corpora lands a marker
+/// roughly every 20-40 bytes, so 64 slots cover a paragraph of about 1.5-2.5
+/// KB — comfortably past the long-line encyclopedia shape this exists for —
+/// for 256 bytes of stack. The buffer is threaded down from `parse_document`
+/// rather than created per paragraph, so a document with one atypically
+/// marker-dense paragraph spills once and then reuses that capacity.
+const MEMO_INLINE: usize = 64;
+
+type MarkerPositions = SmallVec<[u32; MEMO_INLINE]>;
+
+/// What one fused line scan found.
+pub(in crate::parser) struct LineScan {
+    /// Offset of the line's terminator, or `bytes.len()` when the last line
+    /// of the source is unterminated.
+    pub(in crate::parser) line_end: usize,
+    /// Whether a `|` occurs before `line_end`. Always `false` when the memo
+    /// was not built for a table-enabled parse.
+    pub(in crate::parser) pipe_seen: bool,
+}
+
+/// Marker positions recorded while block parsing walked a paragraph's lines.
+pub(in crate::parser) struct MarkerMemo {
+    /// Nibble classifier for the enabled marker set, extended with `|` when
+    /// the table check needs it.
+    #[cfg_attr(not(target_arch = "aarch64"), allow(dead_code))]
+    low: [u8; 16],
+    #[cfg_attr(not(target_arch = "aarch64"), allow(dead_code))]
+    high: [u8; 16],
+    /// The same marker set as an option mask, for the portable scan.
+    #[cfg_attr(target_arch = "aarch64", allow(dead_code))]
+    optional: u8,
+    #[cfg_attr(target_arch = "aarch64", allow(dead_code))]
+    tables: bool,
+    /// Whether this parse records at all. The definition-collection phase
+    /// builds no inline content, and a test switch turns recording off to
+    /// run the same document through the original two-scan path.
+    record: bool,
+    /// Whether the current block's recording is complete. A line consumed
+    /// without being scanned (a line comment) leaves a hole, and the block
+    /// falls back to scanning its content.
+    usable: bool,
+    positions: MarkerPositions,
+}
+
+impl MarkerMemo {
+    pub(in crate::parser) fn new(options: &crate::ParserOptions, record: bool) -> Self {
+        let optional = optional_marker_bits(options);
+        let (low, high) = selected_marker_tables(optional);
+        let mut low = *low;
+        if options.tables {
+            low[PIPE_TABLE_INDEX] |= PIPE_TABLE_BIT;
+        }
+        Self {
+            low,
+            high: *high,
+            optional,
+            tables: options.tables,
+            record: record && recording_enabled(),
+            usable: false,
+            positions: MarkerPositions::new(),
+        }
+    }
+
+    /// Whether the fused scan runs for this parse.
+    pub(in crate::parser) const fn recording(&self) -> bool {
+        self.record
+    }
+
+    /// Whether the recording covers the current block's whole content.
+    pub(in crate::parser) const fn usable(&self) -> bool {
+        self.record && self.usable
+    }
+
+    /// Starts a new block's recording.
+    pub(in crate::parser) fn reset(&mut self) {
+        self.positions.clear();
+        self.usable = true;
+    }
+
+    /// Marks the current block's recording incomplete.
+    pub(in crate::parser) fn invalidate(&mut self) {
+        self.usable = false;
+    }
+
+    pub(in crate::parser) fn len(&self) -> usize {
+        self.positions.len()
+    }
+
+    pub(in crate::parser) fn truncate(&mut self, len: usize) {
+        self.positions.truncate(len);
+    }
+
+    /// Scans one line starting at `from`, appending every inline marker it
+    /// holds. The line terminator itself is not appended: whether it belongs
+    /// to the block's content is the caller's decision, made by
+    /// [`Self::push_line_terminator`].
+    pub(in crate::parser) fn scan_line(&mut self, bytes: &[u8], from: usize) -> LineScan {
+        self.scan_line_arch(bytes, from)
+    }
+
+    #[cfg(target_arch = "aarch64")]
+    fn scan_line_arch(&mut self, bytes: &[u8], from: usize) -> LineScan {
+        let Self {
+            low,
+            high,
+            positions,
+            ..
+        } = self;
+        scan_line_neon(bytes, from, low, high, positions)
+    }
+
+    #[cfg(not(target_arch = "aarch64"))]
+    fn scan_line_arch(&mut self, bytes: &[u8], from: usize) -> LineScan {
+        let Self {
+            optional,
+            tables,
+            positions,
+            ..
+        } = self;
+        scan_line_portable(bytes, from, *optional, *tables, positions)
+    }
+
+    /// Records the line terminator bytes at `line_end` as markers and returns
+    /// the next line's start.
+    ///
+    /// `\n` and `\r` are inline markers, and a CRLF holds two of them. A
+    /// terminator that ends up outside the block's trimmed content is dropped
+    /// by [`Self::range`], so recording it unconditionally is safe.
+    pub(in crate::parser) fn push_line_terminator(
+        &mut self,
+        bytes: &[u8],
+        line_end: usize,
+    ) -> usize {
+        let next = line_terminator_end(bytes, line_end);
+        for at in line_end..next {
+            self.positions.push(at as u32);
+        }
+        next
+    }
+
+    /// The recorded positions inside `base..end`, both source offsets.
+    pub(in crate::parser) fn range(&self, base: usize, end: usize) -> &[u32] {
+        let first = self.positions.partition_point(|&at| (at as usize) < base);
+        let last = self.positions.partition_point(|&at| (at as usize) < end);
+        &self.positions[first..last]
+    }
+}
+
+/// Reports a hit run from one classifier mask, in increasing order.
+///
+/// Returns the offset of the line terminator that ended the line, if this
+/// mask contained one. `|` is reported through `pipe` and never recorded:
+/// it is a table marker, not an inline one.
+#[cfg(target_arch = "aarch64")]
+#[inline]
+fn drain_mask(
+    bytes: &[u8],
+    base: usize,
+    mut mask: u64,
+    out: &mut MarkerPositions,
+    pipe: &mut bool,
+) -> Option<usize> {
+    while mask != 0 {
+        let lane = (mask.trailing_zeros() / 4) as usize;
+        let at = base + lane;
+        let byte = bytes[at];
+        if byte == b'\n' || byte == b'\r' {
+            return Some(at);
+        }
+        if byte == b'|' {
+            *pipe = true;
+        } else {
+            out.push(at as u32);
+        }
+        mask &= !(0xF_u64 << (lane * 4));
+    }
+    None
+}
+
+#[cfg(target_arch = "aarch64")]
+#[allow(unsafe_code)]
+fn scan_line_neon(
+    bytes: &[u8],
+    from: usize,
+    low_table: &[u8; 16],
+    high_table: &[u8; 16],
+    out: &mut MarkerPositions,
+) -> LineScan {
+    use std::arch::aarch64::*;
+    let end = bytes.len();
+    let mut i = from;
+    let mut pipe_seen = false;
+    // SAFETY: every 16-byte load is bounded by an explicit `i + 16 <= end`
+    // check, or reads the final full vector at `end - 16` under `end >= 16`.
+    // The tail mask shift is at most 60 because the loops leave
+    // `end - 16 < i < end`.
+    unsafe {
+        let low = vld1q_u8(low_table.as_ptr());
+        let high = vld1q_u8(high_table.as_ptr());
+        let nibble = vdupq_n_u8(0x0F);
+        let classify = |v: uint8x16_t| {
+            let lo = vqtbl1q_u8(low, vandq_u8(v, nibble));
+            let hi = vqtbl1q_u8(high, vshrq_n_u8(v, 4));
+            // `vtstq_u8` turns the per-lane AND into the all-ones/all-zeros
+            // form the nibble-narrowing mask extraction needs.
+            let m = vtstq_u8(lo, hi);
+            let narrow = vshrn_n_u16(vreinterpretq_u16_u8(m), 4);
+            vget_lane_u64(vreinterpret_u64_u8(narrow), 0)
+        };
+        while i + 32 <= end {
+            let m0 = classify(vld1q_u8(bytes.as_ptr().add(i)));
+            if let Some(line_end) = drain_mask(bytes, i, m0, out, &mut pipe_seen) {
+                return LineScan {
+                    line_end,
+                    pipe_seen,
+                };
+            }
+            let m1 = classify(vld1q_u8(bytes.as_ptr().add(i + 16)));
+            if let Some(line_end) = drain_mask(bytes, i + 16, m1, out, &mut pipe_seen) {
+                return LineScan {
+                    line_end,
+                    pipe_seen,
+                };
+            }
+            i += 32;
+        }
+        while i + 16 <= end {
+            let mask = classify(vld1q_u8(bytes.as_ptr().add(i)));
+            if let Some(line_end) = drain_mask(bytes, i, mask, out, &mut pipe_seen) {
+                return LineScan {
+                    line_end,
+                    pipe_seen,
+                };
+            }
+            i += 16;
+        }
+        if i < end && end >= 16 {
+            // Overlapping tail: re-read the last vector and drop the lanes
+            // the loops already cleared, so no position is recorded twice.
+            // `vtstq_u8` is exact per lane.
+            let base = end - 16;
+            let mask =
+                classify(vld1q_u8(bytes.as_ptr().add(base))) & (u64::MAX << ((i - base) * 4));
+            if let Some(line_end) = drain_mask(bytes, base, mask, out, &mut pipe_seen) {
+                return LineScan {
+                    line_end,
+                    pipe_seen,
+                };
+            }
+            return LineScan {
+                line_end: end,
+                pipe_seen,
+            };
+        }
+    }
+    let tail = scan_line_scalar(bytes, i, low_table, high_table, out);
+    LineScan {
+        line_end: tail.line_end,
+        pipe_seen: pipe_seen || tail.pipe_seen,
+    }
+}
+
+/// The definition the vectorized scan has to agree with, and the short-tail
+/// path on targets that run it.
+#[cfg_attr(not(target_arch = "aarch64"), allow(dead_code))]
+fn scan_line_scalar(
+    bytes: &[u8],
+    from: usize,
+    low_table: &[u8; 16],
+    high_table: &[u8; 16],
+    out: &mut MarkerPositions,
+) -> LineScan {
+    let mut pipe_seen = false;
+    let mut i = from;
+    while i < bytes.len() {
+        let byte = bytes[i];
+        if low_table[(byte & 0x0F) as usize] & high_table[(byte >> 4) as usize] != 0 {
+            if byte == b'\n' || byte == b'\r' {
+                return LineScan {
+                    line_end: i,
+                    pipe_seen,
+                };
+            }
+            if byte == b'|' {
+                pipe_seen = true;
+            } else {
+                out.push(i as u32);
+            }
+        }
+        i += 1;
+    }
+    LineScan {
+        line_end: bytes.len(),
+        pipe_seen,
+    }
+}
+
+/// Portable fusion: the existing marker scan drives the walk and only the
+/// hits are inspected, so targets with their own vector classifier keep it.
+///
+/// The `|` probe stays a separate `memchr` here rather than a table bit,
+/// which leaves this path with the same two passes over a line that block
+/// parsing already made — the saving is the inline rescan, not the probe.
+///
+/// Compiled under `cfg(test)` on aarch64 as well, so the differential tests
+/// hold it to the same oracle wherever they run.
+#[cfg(any(not(target_arch = "aarch64"), test))]
+fn scan_line_portable(
+    bytes: &[u8],
+    from: usize,
+    optional: u8,
+    tables: bool,
+    out: &mut MarkerPositions,
+) -> LineScan {
+    let mut i = from;
+    let line_end = loop {
+        i = super::inline::next_inline_marker(bytes, i, optional);
+        if i == bytes.len() || bytes[i] == b'\n' || bytes[i] == b'\r' {
+            break i;
+        }
+        out.push(i as u32);
+        i += 1;
+    };
+    LineScan {
+        line_end,
+        pipe_seen: tables && memchr::memchr(b'|', &bytes[from..line_end]).is_some(),
+    }
+}
