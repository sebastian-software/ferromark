+            include_str!("../../../benches/fixtures/upstream-changelog.md"),
+        ),
+    ];
+    let profiles = [
+        ("commonmark", ParserOptions::commonmark()),
+        ("gfm", ParserOptions::gfm()),
+        (
+            "everything",
+            ParserOptions {
+                highlight: true,
+                inline_footnotes: true,
+                superscript: true,
+                math: true,
+                definition_lists: true,
+                heading_attributes: true,
+                line_comments: true,
+                ..ParserOptions::gfm()
+            },
+        ),
+    ];
+    for (fixture, source) in fixtures {
+        for (name, options) in &profiles {
+            assert_same_parse(source, options, &format!("{name}: {fixture}"));
+            let crlf = source.replace('\n', "\r\n");
+            assert_same_parse(&crlf, options, &format!("{name}: {fixture} (CRLF)"));
+        }
+    }
+}
