+/// Optional-marker bits enabled by `options`.
+///
+/// The block-level line scan classifies with the very same set, so this is
+/// the single definition both the scanning and the recorded source derive
+/// their marker table from.
+pub(in crate::parser) const fn optional_marker_bits(options: &crate::ParserOptions) -> u8 {
+    let mut optional = 0;
+    if options.mdx {
+        optional |= INLINE_MARKER_MDX;
+    }
+    if options.superscript || options.inline_footnotes {
+        optional |= INLINE_MARKER_SUPERSCRIPT;
+    }
+    if options.math {
+        optional |= INLINE_MARKER_MATH;
+    }
+    if options.highlight {
+        optional |= INLINE_MARKER_HIGHLIGHT;
+    }
+    optional
+}
+
+/// Marker offsets a block-level line scan already found, in source
+/// coordinates, together with the source offset of the block's content.
+///
+/// The positions are ascending and cover exactly `base..base + content.len()`.
+#[derive(Clone, Copy)]
+pub(in crate::parser) struct RecordedMarkers<'m> {
+    positions: &'m [u32],
+    base: usize,
+}
+
+impl<'m> RecordedMarkers<'m> {
+    pub(in crate::parser) const fn new(positions: &'m [u32], base: usize) -> Self {
+        Self { positions, base }
+    }
+}
+
+/// Walks recorded positions instead of rescanning the bytes.
+///
+/// Inline parsing asks for the next marker at or after a cursor that almost
+/// always moves forward, so the common step is "advance an index while it
+/// points before `from`". A backwards move — which the walk does not
+/// currently make, but which costs nothing to tolerate — re-seats the index
+/// with a binary search rather than silently returning a stale hit.
+struct RecordedCursor<'m> {
+    positions: &'m [u32],
+    base: usize,
+    end: usize,
+    index: usize,
+    last_from: usize,
+}
+
+impl RecordedCursor<'_> {
+    fn at_least(&mut self, from: usize) -> usize {
+        let wanted = self.base + from;
+        if from < self.last_from {
+            self.index = self.positions.partition_point(|&at| (at as usize) < wanted);
+        } else {
+            while self
+                .positions
+                .get(self.index)
+                .is_some_and(|&at| (at as usize) < wanted)
+            {
+                self.index += 1;
+            }
+        }
+        self.last_from = from;
+        self.positions
+            .get(self.index)
+            .map_or(self.end, |&at| at as usize - self.base)
+    }
+}
+
+/// Where the marker positions of the current inline content come from.
+enum MarkerSource<'m> {
+    /// Scan the bytes on demand.
+    Fresh(ForwardScan),
+    /// Replay what the block-level line scan already found.
+    Recorded(RecordedCursor<'m>),
+}
