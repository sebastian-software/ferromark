+#[test]
+fn paths_without_a_complete_recording_fall_back_to_scanning() {
+    let gfm = ParserOptions::gfm();
+    // A setext heading is not a paragraph, and a paragraph holding a line
+    // comment has a hole in its recording.
+    for source in ["heading text\n===\n", "para\n---\n"] {
+        assert_eq!(replays(|| drop(debug_parse(source, &gfm))), 0, "{source:?}");
+    }
+    let commented = ParserOptions {
+        line_comments: true,
+        ..ParserOptions::gfm()
+    };
+    assert_eq!(
+        replays(|| drop(debug_parse("para one\n// note\npara two\n", &commented))),
+        0
+    );
+    // A trailing comment leaves the content itself fully recorded, but the
+    // paragraph still gives up its memo rather than reasoning about the hole.
+    assert_eq!(
+        replays(|| drop(debug_parse("para one\n// trailing\n", &commented))),
+        0
+    );
+}
