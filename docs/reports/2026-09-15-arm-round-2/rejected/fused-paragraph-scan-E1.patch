+#[test]
+fn ordinary_paragraphs_replay_a_recording() {
+    let source = "a paragraph with *markers* and [a link](/x)\nand a second line\n\n\
+                  | pipe | in prose\n\nlast paragraph\n";
+    for (name, options) in [
+        ("commonmark", ParserOptions::commonmark()),
+        ("gfm", ParserOptions::gfm()),
+    ] {
+        let replayed = replays(|| drop(debug_parse(source, &options)));
+        assert_eq!(replayed, 3, "{name} should replay every paragraph");
+        let scanned = replays(|| without_recording(|| drop(debug_parse(source, &options))));
+        assert_eq!(scanned, 0, "{name} should not replay with recording off");
+    }
+}
