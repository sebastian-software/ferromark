+/// How many blocks `body` parsed by replaying a recording.
+///
+/// Keeps the differential tests honest: if both sides silently fell back to
+/// scanning, they would agree while proving nothing.
+#[cfg(test)]
+pub(in crate::parser) fn replays(body: impl FnOnce()) -> usize {
+    REPLAYS.with(|count| count.set(0));
+    body();
+    REPLAYS.with(std::cell::Cell::get)
+}
