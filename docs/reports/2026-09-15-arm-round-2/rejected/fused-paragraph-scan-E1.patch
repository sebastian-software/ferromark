+//! Fused line scan equivalence, and whole-document differential parses.
+//!
+//! The scanner tests pin the classifier: recorded positions, line end, and
+//! the `|` flag have to match a byte-at-a-time oracle for every byte value at
+//! every offset, and `|` must never be recorded as an inline marker.
+//!
+//! The document tests pin the consequence: parsing with the memo and with the
+//! original two-scan path has to produce byte-identical `Debug` output —
+//! every node, every span — and byte-identical HTML.
+
+// Test oracles and comparisons work with owned strings and vectors.
+#![allow(
+    clippy::disallowed_macros,
+    clippy::disallowed_methods,
+    clippy::disallowed_types
+)]
+
+use super::*;
+use crate::allocator::Allocator;
+use crate::parser::{Parser, ParserOptions};
+
+/// The marker set the inline scan recognizes, written out independently of
+/// the nibble tables the fused scan classifies with.
+fn is_marker(byte: u8, mask: u8) -> bool {
+    matches!(
+        byte,
+        b'*' | b'_' | b'`' | b'[' | b'!' | b'~' | b'\\' | b'<' | b'&' | b'\n' | b'\r'
+    ) || (mask & 1 != 0 && byte == b'{')
+        || (mask & 2 != 0 && byte == b'^')
+        || (mask & 4 != 0 && byte == b'$')
+        || (mask & 8 != 0 && byte == b'=')
+}
+
+/// Options producing exactly optional-marker mask `mask`.
+fn options_for(mask: u8, tables: bool) -> ParserOptions {
+    ParserOptions {
+        mdx: mask & 1 != 0,
+        superscript: mask & 2 != 0,
+        math: mask & 4 != 0,
+        highlight: mask & 8 != 0,
+        tables,
+        ..ParserOptions::default()
+    }
+}
+
+struct Expected {
+    line_end: usize,
+    pipe_seen: bool,
+    positions: Vec<u32>,
+}
+
+fn oracle(bytes: &[u8], from: usize, mask: u8, tables: bool) -> Expected {
+    let mut positions = Vec::new();
+    let mut at = from;
+    while at < bytes.len() {
+        let byte = bytes[at];
+        if byte == b'\n' || byte == b'\r' {
+            break;
+        }
+        if is_marker(byte, mask) {
+            positions.push(at as u32);
+        }
+        at += 1;
+    }
+    Expected {
+        line_end: at,
+        pipe_seen: tables && memchr::memchr(b'|', &bytes[from..at]).is_some(),
+        positions,
+    }
+}
+
+fn check(bytes: &[u8], from: usize, mask: u8, tables: bool, label: &str) {
+    let expected = oracle(bytes, from, mask, tables);
+    let mut memo = MarkerMemo::new(&options_for(mask, tables), true);
+    memo.reset();
+    let scan = memo.scan_line(bytes, from);
+    assert_eq!(scan.line_end, expected.line_end, "line end: {label}");
+    assert_eq!(scan.pipe_seen, expected.pipe_seen, "pipe: {label}");
+    assert_eq!(
+        memo.positions.as_slice(),
+        expected.positions.as_slice(),
+        "positions: {label}"
+    );
+
+    // The scalar fallback is the definition the vector path has to match, so
+    // it is checked over the same inputs rather than only as a short tail.
+    let mut scalar = MarkerPositions::new();
+    let fallback = scan_line_scalar(bytes, from, &memo.low, &memo.high, &mut scalar);
+    assert_eq!(fallback.line_end, expected.line_end, "scalar end: {label}");
+    assert_eq!(
+        fallback.pipe_seen, expected.pipe_seen,
+        "scalar pipe: {label}"
+    );
+    assert_eq!(
+        scalar.as_slice(),
+        expected.positions.as_slice(),
+        "scalar positions: {label}"
+    );
+
+    // The portable backend runs in production on every target without NEON,
+    // so it is held to the same oracle even where NEON is what ships.
+    let mut portable = MarkerPositions::new();
+    let other = scan_line_portable(bytes, from, memo.optional, memo.tables, &mut portable);
+    assert_eq!(other.line_end, expected.line_end, "portable end: {label}");
+    assert_eq!(
+        other.pipe_seen, expected.pipe_seen,
+        "portable pipe: {label}"
+    );
+    assert_eq!(
+        portable.as_slice(),
+        expected.positions.as_slice(),
+        "portable positions: {label}"
+    );
+}
+
+#[test]
+fn pipe_table_bit_admits_exactly_the_pipe() {
+    for mask in 0..=15u8 {
+        let plain = MarkerMemo::new(&options_for(mask, false), true);
+        let piped = MarkerMemo::new(&options_for(mask, true), true);
+        for byte in 0..=u8::MAX {
+            let low = usize::from(byte & 0x0F);
+            let high = usize::from(byte >> 4);
+            assert_eq!(
+                plain.low[low] & plain.high[high] != 0,
+                is_marker(byte, mask),
+                "plain table disagrees on {byte:#04x} for mask {mask}"
+            );
+            assert_eq!(
+                piped.low[low] & piped.high[high] != 0,
+                is_marker(byte, mask) || byte == b'|',
+                "pipe table disagrees on {byte:#04x} for mask {mask}"
+            );
+        }
+    }
+}
