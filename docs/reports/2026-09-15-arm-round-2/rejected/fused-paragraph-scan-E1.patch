+/// Runs `body` with the marker memo turned off, so a differential test can
+/// parse the same document through the line scan block parsing used before.
+#[cfg(test)]
+pub(in crate::parser) fn without_recording<T>(body: impl FnOnce() -> T) -> T {
+    struct Restore;
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            RECORDING_DISABLED.with(|disabled| disabled.set(false));
+        }
+    }
+    RECORDING_DISABLED.with(|disabled| disabled.set(true));
+    let _restore = Restore;
+    body()
+}
