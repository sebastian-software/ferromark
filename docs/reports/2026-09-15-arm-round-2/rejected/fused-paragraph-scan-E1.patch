+#[test]
+fn records_the_line_terminator_bytes_inside_the_block() {
+    for (source, expected) in [
+        ("ab\ncd", &[2u32][..]),
+        ("ab\r\ncd", &[2, 3][..]),
+        ("ab\rcd", &[2][..]),
+        ("ab", &[][..]),
+    ] {
+        let bytes = source.as_bytes();
+        let mut memo = MarkerMemo::new(&ParserOptions::default(), true);
+        memo.reset();
+        let scan = memo.scan_line(bytes, 0);
+        let next = memo.push_line_terminator(bytes, scan.line_end);
+        assert_eq!(memo.positions.as_slice(), expected, "{source:?}");
+        assert_eq!(
+            next,
+            if expected.is_empty() {
+                2
+            } else {
+                2 + expected.len()
+            }
+        );
+    }
+}
+
+#[test]
+fn range_keeps_only_the_trimmed_content() {
+    let mut memo = MarkerMemo::new(&ParserOptions::default(), true);
+    memo.reset();
+    memo.positions.extend_from_slice(&[2, 5, 9, 14, 20]);
+    assert_eq!(memo.range(5, 15), &[5, 9, 14]);
+    assert_eq!(memo.range(0, 100), &[2, 5, 9, 14, 20]);
+    assert_eq!(memo.range(6, 9), &[] as &[u32]);
+}
