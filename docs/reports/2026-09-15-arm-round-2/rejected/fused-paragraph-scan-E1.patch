+#[test]
+fn matches_the_oracle_for_every_byte_value_at_every_offset() {
+    // Long enough to cross the 32-byte dual-vector step, the 16-byte
+    // overlapping tail, and the scalar remainder.
+    for value in 0..=u8::MAX {
+        for at in 0..72usize {
+            let mut buffer = [b'x'; 72];
+            buffer[at] = value;
+            for mask in [0u8, 15] {
+                for tables in [false, true] {
+                    check(
+                        &buffer,
+                        0,
+                        mask,
+                        tables,
+                        &format!("value {value:#04x} at {at} mask {mask} tables {tables}"),
+                    );
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn matches_the_oracle_from_every_offset_and_length() {
+    for mask in 0..=15u8 {
+        for len in 0..=72usize {
+            let mut buffer = [b'x'; 72];
+            for (at, byte) in buffer[..len].iter_mut().enumerate() {
+                *byte = match at % 17 {
+                    0 => b'|',
+                    1 => b'*',
+                    2 => b'{',
+                    3 => b'^',
+                    4 => b'$',
+                    5 => b'=',
+                    6 => b'\\',
+                    7 => 0xC3,
+                    8 => b'\n',
+                    9 => b'\r',
+                    10 => b'_',
+                    11 => b'`',
+                    12 => b'[',
+                    13 => b'!',
+                    14 => b'~',
+                    15 => b'&',
+                    _ => b'<',
+                };
+            }
+            let bytes = &buffer[..len];
+            for from in 0..=len {
+                for tables in [false, true] {
+                    check(
+                        bytes,
+                        from,
+                        mask,
+                        tables,
+                        &format!("mask {mask} len {len} from {from} tables {tables}"),
+                    );
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn matches_the_oracle_on_pseudo_random_buffers() {
+    // A small xorshift keeps the corpus reproducible without a dependency.
+    let mut state = 0x2545_F491_4F6C_DD1D_u64;
+    let mut next = move || {
+        state ^= state << 13;
+        state ^= state >> 7;
+        state ^= state << 17;
+        state
+    };
+    for round in 0..200 {
+        let len = usize::try_from(next() % 200).unwrap();
+        let mut buffer = Vec::with_capacity(len);
+        for _ in 0..len {
+            // Bias towards markers so lines stay short and hits stay dense.
+            let pick = next();
+            buffer.push(match pick % 5 {
+                0 => b"*_`[!~\\<&{^$=|"[usize::try_from(pick / 5 % 14).unwrap()],
+                1 => b"\n\r \t"[usize::try_from(pick / 5 % 4).unwrap()],
+                _ => u8::try_from(pick % 256).unwrap(),
+            });
+        }
+        for mask in [0u8, 3, 12, 15] {
+            for tables in [false, true] {
+                for from in [0, len / 3, len] {
+                    check(
+                        &buffer,
+                        from,
+                        mask,
+                        tables,
+                        &format!("round {round} mask {mask} tables {tables} from {from}"),
+                    );
+                }
+            }
+        }
+    }
+}
