+            pos = code[ci].closer_end as usize;
+            continue;
+        }
+        if let Some(autolink) = try_parse_autolink(text, idx) {
+            pos = autolink.end as usize;
+            out.push(autolink);
+        } else { pos = idx + 1; }
+    }
