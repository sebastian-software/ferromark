[
  {
    "id": "url-backslash-path",
    "kind": "normative",
    "profile": "commonmark",
    "markdown": "[link](foo\\bar)\n",
    "expected": "<p><a href=\"foo%5Cbar\">link</a></p>\n",
    "reference": "CommonMark 0.31.2 example 502; URL Standard special-scheme backslash handling",
    "error": null,
    "html": "<p><a href=\"foo%5Cbar\">link</a></p>\n",
    "spec_actual": "<p><a href=\"foo%5Cbar\">link</a></p>",
    "spec_equal": true,
    "spec_expected": "<p><a href=\"foo%5Cbar\">link</a></p>",
    "status": "exact"
  },
