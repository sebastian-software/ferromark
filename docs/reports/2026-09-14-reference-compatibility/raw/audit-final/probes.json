    "reference": "GFM formal extensions do not include footnotes",
    "error": null,
    "html": "<p>A<sup><a href=\"#fn-1\" id=\"fnref-1\">1</a></sup>.</p>\n<div id=\"fn-1\" class=\"footnote\">\n<p>note</p>\n<a href=\"#fnref-1\">↩</a>\n</div>\n",
    "spec_actual": "<p>A<sup><a href=\"#fn-1\" id=\"fnref-1\">1</a></sup>.</p><div class=\"footnote\" id=\"fn-1\"><p>note</p><a href=\"#fnref-1\">↩</a></div>",
    "spec_equal": false,
    "spec_expected": "<p>A<a href=\"note\">^1</a>.</p>",
    "status": "other"
  },
