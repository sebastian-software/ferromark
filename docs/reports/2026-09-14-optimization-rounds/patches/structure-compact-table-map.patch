+fn table_cell_boundary_offset(index: usize, removed_backslashes: &[u32]) -> u32 {
+    // Removed positions are expressed in generated coordinates. A boundary
+    // exactly at a removed position is before the removed byte; the next
+    // boundary is after it, hence the strict `<` comparison.
+    let removed_before = removed_backslashes.partition_point(|&position| position < index as u32);
+    index as u32 + removed_before as u32
 }
 
