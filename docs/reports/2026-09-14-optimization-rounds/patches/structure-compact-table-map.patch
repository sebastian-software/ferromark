+#[test]
+fn adjacent_escaped_pipes_map_each_generated_boundary() {
+    let allocator = Allocator::new();
+    let result = unescape_table_pipes(&allocator, r"a\|\|b");
+    assert_eq!(result.content, "a||b");
+    let removed_positions = result.removed_backslashes.unwrap();
+    assert_eq!(removed_positions.as_slice(), &[1, 2]);
+    let mapped = std::array::from_fn(|boundary| {
+        super::table_cell_boundary_offset(boundary, &removed_positions)
+    });
+    assert_eq!(mapped, [0, 1, 3, 5, 6]);
+}
