+
+const SOURCE_MAP_BLOCK_BYTES: usize = 64;
+
+#[derive(Clone, Copy)]
+struct SourceMapBlock {
+    bits: u64,
+    prefix: u32,
+}
+
+/// Compact rank index for the bytes removed from a table cell. Each block
+/// keeps one bit per generated byte and the number of removed bytes before
+/// that block, making boundary remapping constant time after a clamp.
+pub(super) struct TableCellSourceMap<'a> {
+    blocks: Vec<'a, SourceMapBlock>,
+    generated_len: u32,
+    removed_total: u32,
+}
+
+impl<'a> TableCellSourceMap<'a> {
+    fn new(allocator: &'a Allocator) -> Self {
+        Self { blocks: allocator.new_vec(), generated_len: 0, removed_total: 0 }
+    }
+
+    fn record_removed(&mut self, generated_position: usize) {
+        let block_index = generated_position / SOURCE_MAP_BLOCK_BYTES;
+        while self.blocks.len() <= block_index {
+            self.blocks.push(SourceMapBlock { bits: 0, prefix: self.removed_total });
+        }
+        self.blocks[block_index].bits |= 1u64 << (generated_position % SOURCE_MAP_BLOCK_BYTES);
+        self.removed_total += 1;
+    }
+
+    fn finish(&mut self, generated_len: usize) {
+        self.generated_len = generated_len as u32;
+    }
+
+    fn boundary_offset(&self, index: usize) -> u32 {
+        // The dense map historically clamped spans beyond the generated
+        // source to its final source boundary. Preserve that behavior before
+        // looking up the rank bitset.
+        let bounded = index.min(self.generated_len as usize);
+        let block_index = bounded / SOURCE_MAP_BLOCK_BYTES;
+        let within_block = bounded % SOURCE_MAP_BLOCK_BYTES;
+        let Some(block) = self.blocks.get(block_index) else {
+            return bounded as u32 + self.removed_total;
+        };
+        let mask = if within_block == 0 { 0 } else { (1u64 << within_block) - 1 };
+        bounded as u32 + block.prefix + (block.bits & mask).count_ones()
+    }
 }
 
