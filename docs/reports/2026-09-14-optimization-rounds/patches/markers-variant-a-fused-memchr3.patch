+/// Marker bits used by [`next_inline_marker`].
+pub(super) const INLINE_MARKER_MDX: u8 = 1 << 0;
+pub(super) const INLINE_MARKER_SUPERSCRIPT: u8 = 1 << 1;
+pub(super) const INLINE_MARKER_MATH: u8 = 1 << 2;
+
+/// Find the next core marker or enabled extension marker.
+///
+/// The core marker scan stays on its architecture-specific classifier. For
+/// optional markers, one `memchr` family pass is enough for every option
+/// combination; the previous implementation kept three independent cached
+/// scans and paid for each enabled marker on every lookup. The zero-mask path
+/// remains exactly the default CommonMark/GFM scan.
+#[inline]
+pub(super) fn next_inline_marker(bytes: &[u8], from: usize, options: u8) -> usize {
+    let special = next_inline_special(bytes, from);
+    if options == 0 || from >= bytes.len() {
+        return special;
+    }
+
+    let optional = match options {
+        INLINE_MARKER_MDX => memchr(b'{', &bytes[from..]),
+        INLINE_MARKER_SUPERSCRIPT => memchr(b'^', &bytes[from..]),
+        INLINE_MARKER_MATH => memchr(b'$', &bytes[from..]),
+        3 => memchr2(b'{', b'^', &bytes[from..]),
+        5 => memchr2(b'{', b'$', &bytes[from..]),
+        6 => memchr2(b'^', b'$', &bytes[from..]),
+        7 => memchr3(b'{', b'^', b'$', &bytes[from..]),
+        _ => None,
+    }
+    .map_or(bytes.len(), |relative| from + relative);
+    special.min(optional)
+}
