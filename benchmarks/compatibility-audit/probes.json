  {
    "id": "url-backslash-path",
    "kind": "normative",
    "profile": "commonmark",
    "markdown": "[link](foo\\bar)\n",
    "expected": "<p><a href=\"foo%5Cbar\">link</a></p>\n",
    "reference": "CommonMark 0.31.2 example 502; URL Standard special-scheme backslash handling"
  },
