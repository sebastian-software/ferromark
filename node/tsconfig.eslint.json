{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["**/*.cjs", "**/*.cts", "**/*.mts", "**/*.ts"],
  "exclude": ["node_modules", "**/dist/**", "**/artifacts/**"]
}
