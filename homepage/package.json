{
  "name": "homepage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ardo dev",
    "build": "ardo build && node scripts/verify-build.mjs && node --test scripts/test-benchmark-platforms.mjs",
    "lint": "oxlint -c oxlint.config.ts && eslint . --max-warnings=0",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc6 --noEmit -p tsconfig.json",
    "preview": "ardo preview",
    "audit": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "ardo": "file:../../ardo/packages/ardo",
    "ferramenta-family": "file:../../ferramenta/packages/family",
    "isbot": "*",
    "mermaid": "^11.16.0"
  },
  "devDependencies": {
    "eslint": "10.4.0",
    "eslint-config-setup": "0.4.0",
    "jiti": "2.7.0",
    "oxfmt": "0.57.0",
    "oxlint": "1.83.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@11.17.0"
}
