{
  "name": "homepage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/write-release-data.mjs && ardo dev",
    "build": "node scripts/write-release-data.mjs && ardo build && node scripts/verify-build.mjs && node --test scripts/test-benchmark-platforms.mjs",
    "lint": "oxlint -c oxlint.config.ts && eslint . --max-warnings=0",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "node scripts/write-release-data.mjs && tsc6 --noEmit -p tsconfig.json",
    "preview": "ardo preview",
    "audit": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "ardo": "^6.0.0",
    "ferramenta-family": "github:sebastian-software/ferramenta#b331165a770d2ce38cf3c57ac6243de836a2bb64&path:/packages/family"
  },
  "devDependencies": {
    "eslint": "10.4.0",
    "eslint-config-setup": "0.4.0",
    "jiti": "2.7.0",
    "jsonc-eslint-parser": "^3.3.0",
    "oxfmt": "0.57.0",
    "oxlint": "1.83.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@11.17.0"
}
